---
import Basics from '@sections/Basics.astro'
import Divider from '@shared/Divider.astro'
import Layout from '@layouts/Layout.astro'
import { getAvailableResumes, getResumeData } from '@lib/resume.js'

// Fontsource imports - these automatically add @font-face rules
import '@fontsource/bungee-shade'
import '@fontsource/bungee'
import '@fontsource/baloo-2'
import '@fontsource/rubik'
import '@fontsource/fredoka'

// Generate static paths for all resume files
export function getStaticPaths() {
  const availableResumes = getAvailableResumes()
  return availableResumes.map(resume => ({
    params: { resume },
    props: { resume }
  }))
}

// Get resume name from path param
const { resume } = Astro.params

// Get available resumes and load data
const availableResumes = getAvailableResumes()
const validResume = resume && availableResumes.includes(resume) ? resume : availableResumes[0]
const resumeData = await getResumeData(validResume)

// Auto-import all section components using import.meta.glob (excluding Basics)
const sectionModules = import.meta.glob('../components/sections/!(Basics).astro', { eager: true })

// Create component mapping from imported components
const components: Record<string, any> = {}
for (const [filePath, module] of Object.entries(sectionModules)) {
  // Extract component name from file path (e.g., "Work" from "Work.astro")
  const fileName = filePath.split('/').pop()?.replace('.astro', '')

  if (fileName && fileName !== 'Basics') {
    const key = fileName.toLowerCase()
    const mod = module as any
    components[key] = mod.default || mod
  }
}

const { basics, meta, ...sections } = resumeData
const themeDefaults = { hue: 240, sat: 60 }
const initialHue = meta?.themeOptions?.hue ?? themeDefaults.hue
const initialSat = meta?.themeOptions?.sat ?? themeDefaults.sat
const initialDark = typeof meta?.themeOptions?.dark === 'boolean' ? meta.themeOptions.dark : undefined
---

<Layout 
  title={basics?.name || 'Resume'}
  description="Professional Resume"
  initialHue={initialHue}
  initialSat={initialSat}
  initialDark={initialDark}
  currentResume={validResume}
  availableResumes={availableResumes}
>
  <Basics basics={basics} meta={meta} />

  <Divider variant="default" />
  <Divider variant="subtle" />
  <Divider variant="accent" />
  <Divider variant="gradient" />

  {Object.entries(sections).map(([key, data]) => {
    const Component = components[key]

    if (Component && data) {
      const props = { [key]: data, meta, resumeData }
      return <Component {...props} />
    }
    return null
  })}
</Layout> 
