---
import Basics from "@resume/Basics.astro";
import SectionRenderer from "@resume/SectionRenderer.astro";
import Divider from "@ui/Divider.astro";
import Layout from "@layouts/Layout.astro";
import {
  getAvailableResumes,
  getResumeData,
  getResumeInfo,
} from "@lib/resume.js";
import pkg from "@pkg";

// Generate static paths for all resume files
export function getStaticPaths() {
  const availableResumes = getAvailableResumes();
  return availableResumes.map((resume) => ({
    params: { resume },
    props: { resume },
  }));
}

// Get resume name from path param
const { resume } = Astro.params;

// Get resume info and load data
const resumeInfo = getResumeInfo(resume);
const resumeData = await getResumeData(resumeInfo.name);

const { basics, meta, $schema, ...sections } = resumeData;
---

<Layout
  title={`${pkg.name.split("-").pop()}·${basics.name}`}
  themeOptions={meta?.themeOptions}
  currentResume={resumeInfo.name}
  availableResumes={getAvailableResumes()}
  resumeData={resumeData}
>
  <Basics basics={basics} meta={meta} />

  <Divider variant="default" />
  <Divider variant="subtle" />
  <Divider variant="accent" />
  <Divider variant="gradient" />

  {
    Object.entries(sections).map(
      ([key, data]) =>
        data && <SectionRenderer sectionKey={key} data={data} meta={meta} />,
    )
  }
</Layout>
