---
import { loadSections } from '../lib/loader.js'
import { getThemeConfig, applyColorTheme } from '../lib/theme.js'
import Basics from '../components/Basics.astro'
import Section from '../components/shared/Section.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import ThemePicker from '../components/ThemePicker.astro'

import * as resumeData from '../data/resume.json'

const { basics, meta } = resumeData
const sections = await loadSections(resumeData)

// Get theme config - will be overridden by client-side script if localStorage exists
const themeConfig = getThemeConfig(meta)

// Generate CSS for color theme variables
const colorThemeCSS = Object.entries(applyColorTheme(themeConfig.color))
  .map(([key, value]) => `${key}: ${value};`)
  .join('\n          ')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{basics?.name || 'Resume'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Prevent FOUC by hiding content until theme is applied -->
    <script>
      // Immediately check localStorage and apply theme before any rendering
      (function() {
        const savedTheme = localStorage.getItem('theme') || 'light';
        const savedColor = localStorage.getItem('selectedThemeColor') || 'indigo';
        
        document.documentElement.setAttribute('data-theme', savedTheme);
        
        // Apply saved color theme immediately
        const themeVars = {
          '--theme-color-primary': `hsl(var(--${savedColor}-7-hsl) / 0.7)`,
          '--theme-color-secondary': `hsl(var(--${savedColor}-6-hsl) / 0.6)`,
          '--theme-color-accent': `hsl(var(--${savedColor}-8-hsl) / 0.8)`,
          '--theme-color-muted': `hsl(var(--${savedColor}-4-hsl) / 0.4)`,
          '--theme-color-border': `hsl(var(--${savedColor}-5-hsl) / 0.3)`,
          '--theme-surface-primary': `hsl(var(--${savedColor}-1-hsl) / 0.6)`,
          '--theme-surface-secondary': `hsl(var(--${savedColor}-2-hsl) / 0.4)`,
          '--theme-surface-tertiary': `hsl(var(--${savedColor}-3-hsl) / 0.3)`,
          '--theme-surface-border': `hsl(var(--${savedColor}-4-hsl) / 0.2)`,
          '--theme-text-primary': `hsl(var(--${savedColor}-12-hsl) / 0.9)`,
          '--theme-text-secondary': `hsl(var(--${savedColor}-11-hsl) / 0.7)`,
          '--theme-text-muted': `hsl(var(--${savedColor}-10-hsl) / 0.5)`,
          '--theme-link': `hsl(var(--${savedColor}-9-hsl) / 0.8)`,
          '--theme-link-hover': `hsl(var(--${savedColor}-10-hsl) / 0.9)`
        };
        
        Object.entries(themeVars).forEach(([key, value]) => {
          document.documentElement.style.setProperty(key, value);
        });
        
        // Show content after theme is applied
        document.documentElement.style.visibility = 'visible';
      })();
    </script>
    
    <style is:global>
      @import '../styles/global.css';
      @import '../styles/fonts.css';
      
      iconify-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
      }
      
      /* Hide content until theme is applied */
      html {
        visibility: hidden;
      }
    </style>
    <style is:global set:html={`
      :root {
        ${colorThemeCSS}
      }
    `} />
  </head>
  <body>
    <script>
      import "iconify-icon";
    </script>
    
    <ThemeToggle />
    
    {import.meta.env.DEV && <ThemePicker />}
    
    <main class="resume">
      <Basics basics={basics} meta={meta} />
      
      {sections.map(({ Component, props, title }) => (
        <Section title={title}>
          <Component {...props} />
        </Section>
      ))}
    </main>
  </body>
</html>

<style>
  .resume {
    max-width: var(--theme-container-max-width);
    margin: 0 auto;
    padding: var(--theme-spacing-xl);
    background: var(--theme-surface-primary);
  }

  @media (max-width: 768px) {
    .resume {
      padding: var(--theme-spacing-lg);
    }
  }
</style>
