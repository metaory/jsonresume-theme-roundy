---
import { loadSections } from '../lib/loader.js'
import { getThemeConfig, applyColorTheme } from '../lib/theme.js'
import Basics from '../components/Basics.astro'
import Section from '../components/shared/Section.astro'
import ThemeToggle from '../components/ThemeToggle.astro'

import * as resumeData from '../data/resume.json'

const { basics, meta } = resumeData
const sections = await loadSections(resumeData)

// Get theme configuration
const themeConfig = getThemeConfig(meta)
const colorThemeVars = applyColorTheme(themeConfig.color)

// Generate CSS string for color theme variables
const colorThemeCSS = colorThemeVars 
  ? Object.entries(colorThemeVars)
      .map(([key, value]) => `${key}: ${value};`)
      .join('\n          ')
  : ''


---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{basics?.name || 'Resume'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      @import '../styles/global.css';
      @import '../styles/fonts.css';
      
      /* Prevent layout shift for Iconify icons */
      iconify-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
      }
    </style>
    {colorThemeCSS && (
      <style is:global set:html={`
        :root {
          ${colorThemeCSS}
        }
      `} />
    )}
  </head>
  <body>
    <script>
      import "iconify-icon";
    </script>
    
    <ThemeToggle />
    
    <main class="resume">
      <Basics basics={basics} meta={meta} />
      
      {sections.map(({ Component, props, title }) => (
        <Section title={title}>
          <Component {...props} />
        </Section>
      ))}
    </main>
  </body>
</html>

<style>
  .resume {
    max-width: var(--theme-container-max-width);
    margin: 0 auto;
    padding: var(--theme-spacing-xl);
    background: var(--theme-surface-primary);
  }

  @media (max-width: 768px) {
    .resume {
      padding: var(--theme-spacing-lg);
    }
  }
</style>
