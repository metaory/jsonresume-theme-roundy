---
import Icon from './shared/Icon.astro';

const { items, meta } = Astro.props;

// Get fluency levels from meta config or use defaults
const fluencyLevels = meta?.themeOptions?.componentConfig?.languages?.levels || {
  'Master': { dots: 5, color: '#10b981', label: 'Native' },
  'Advanced': { dots: 4, color: '#3b82f6', label: 'Fluent' },
  'Intermediate': { dots: 3, color: '#f59e0b', label: 'Conversational' },
  'Beginner': { dots: 2, color: '#ef4444', label: 'Basic' }
};
---

<div class="languages">
  <div class="languages-grid">
    {items.map(lang => {
      const level = fluencyLevels[lang.fluency] || fluencyLevels['Beginner'];
      return (
        <div class="language-item">
          <div class="language-info">
            <h4 class="language-name">{lang.language}</h4>
            <div class="fluency-indicator">
              <div class="fluency-dots">
                {Array.from({ length: 5 }, (_, i) => (
                  <div 
                    class={`fluency-dot ${i < level.dots ? 'filled' : ''}`}
                    style={i < level.dots ? `background: ${level.color};` : ''}
                  ></div>
                ))}
              </div>
              <span class="fluency-label" style={`color: ${level.color};`}>
                {level.label}
              </span>
            </div>
          </div>
        </div>
      );
    })}
  </div>
  
  <div class="fluency-legend">
    <span class="legend-title">Fluency Levels:</span>
    <div class="legend-items">
      {Object.entries(fluencyLevels).map(([level, config]) => (
        <div class="legend-item">
          <div class="fluency-dots">
            {Array.from({ length: 5 }, (_, i) => (
              <div 
                class={`fluency-dot ${i < config.dots ? 'filled' : ''}`}
                style={i < config.dots ? `background: ${config.color};` : ''}
              ></div>
            ))}
          </div>
          <span class="legend-label">{config.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .languages {
    display: flex;
    flex-direction: column;
    gap: var(--theme-spacing-lg);
  }
  
  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--theme-spacing-md);
  }
  
  .language-item {
    background: var(--theme-surface-secondary);
    border-radius: var(--theme-border-radius-lg);
    padding: var(--theme-spacing-lg);
    border: var(--theme-border-width-thin) solid var(--theme-border-color);
    transition: transform var(--theme-transition-normal) var(--theme-easing);
  }
  
  .language-item:hover {
    transform: translateY(-2px);
  }
  
  .language-info {
    display: flex;
    flex-direction: column;
    gap: var(--theme-spacing-sm);
  }
  
  .language-name {
    margin: 0;
    font-size: var(--theme-font-size-lg);
    font-weight: var(--theme-font-weight-semibold);
    color: var(--theme-text-primary);
  }
  
  .fluency-indicator {
    display: flex;
    flex-direction: column;
    gap: var(--theme-spacing-xs);
  }
  
  .fluency-dots {
    display: flex;
    gap: 2px;
  }
  
  .fluency-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--theme-border-color);
    transition: background var(--theme-transition-normal) var(--theme-easing);
  }
  
  .fluency-dot.filled {
    background: var(--theme-color-primary);
  }
  
  .fluency-label {
    font-size: var(--theme-font-size-sm);
    font-weight: var(--theme-font-weight-medium);
  }
  
  .fluency-legend {
    background: var(--theme-surface-primary);
    border-radius: var(--theme-border-radius-lg);
    padding: var(--theme-spacing-md);
    border: var(--theme-border-width-thin) solid var(--theme-border-color);
  }
  
  .legend-title {
    font-weight: var(--theme-font-weight-semibold);
    color: var(--theme-text-secondary);
    margin-bottom: var(--theme-spacing-sm);
    display: block;
  }
  
  .legend-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--theme-spacing-md);
  }
  
  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--theme-spacing-xs);
  }
  
  .legend-label {
    font-size: var(--theme-font-size-sm);
    color: var(--theme-text-secondary);
  }
</style> 