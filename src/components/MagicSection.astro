---
import { getFieldConfigs } from '../lib/render.js';
import Tag from './shared/Tag.astro';
import DateRange from './shared/DateRange.astro';

const { items, meta, sectionName } = Astro.props;

// Pure function to render field
const renderField = (field) => {
  const fieldMap = {
    isList: () => ({ type: 'ul', class: field.class, items: field.value }),
    isTags: () => ({ type: 'tags', class: field.class, items: field.value }),
    h3: () => ({ type: 'h3', class: field.class, value: field.value }),
    p: () => ({ type: 'p', class: field.class, value: field.value }),
    a: () => ({ type: 'a', class: field.class, value: field.value, href: field.href === true ? field.value : field.href + field.value }),
    time: () => ({ type: 'time', class: field.class, value: field.value }),
    span: () => ({ type: 'span', class: field.class, value: field.value })
  };
  
  const key = field.isList ? 'isList' : field.isTags ? 'isTags' : field.tag;
  return fieldMap[key]?.() || fieldMap.p();
};

// Pure function to create layout data
const createLayout = (item, fields) => {
  const layouts = {
    work: () => ({
      type: 'work',
      title: fields.map(renderField),
      meta: { location: item.location, startDate: item.startDate, endDate: item.endDate },
      content: fields.filter(f => ['summary', 'highlights', 'keywords', 'courses'].includes(f.key)).map(renderField)
    }),
    volunteer: () => layouts.work(),
    education: () => layouts.work(),
    projects: () => ({
      type: 'project',
      header: fields.filter(f => ['name', 'url'].includes(f.key)).map(renderField),
      dates: item.startDate ? { startDate: item.startDate, endDate: item.endDate } : null,
      content: fields.filter(f => ['description', 'highlights', 'keywords', 'roles'].includes(f.key)).map(renderField)
    }),
    skills: () => ({ type: 'skill', fields: fields.map(renderField) }),
    default: () => ({ type: 'default', fields: fields.map(renderField) })
  };
  
  return layouts[sectionName]?.() || layouts.default();
};

// Pipeline: data → layout
const renderedItems = items
  .map(item => ({ item, fields: getFieldConfigs(item) }))
  .map(({ item, fields }) => createLayout(item, fields));
---

<div class={`${sectionName}-section`}>
  {renderedItems.map((item) => {
    if (item.type === 'work') {
      return (
        <div class="item">
          <div class="item-header">
            <div class="item-title">
              {item.title.map((field) => {
                if (field.type === 'ul') return <ul class={field.class}>{field.items.map(item => <li>{item}</li>)}</ul>;
                if (field.type === 'tags') return <div class={field.class}>{field.items.map(item => <Tag text={item} />)}</div>;
                if (field.type === 'h3') return <h3 class={field.class}>{field.value}</h3>;
                if (field.type === 'p') return <p class={field.class}>{field.value}</p>;
                if (field.type === 'a') return <a class={field.class} href={field.href}>{field.value}</a>;
                if (field.type === 'time') return <time class={field.class}>{field.value}</time>;
                if (field.type === 'span') return <span class={field.class}>{field.value}</span>;
                return <p class={field.class}>{field.value}</p>;
              })}
            </div>
            <div class="item-meta">
              {item.meta.location && <span class="item-location">{item.meta.location}</span>}
              <DateRange start={item.meta.startDate} end={item.meta.endDate} />
            </div>
          </div>
          {item.content.map((field) => {
            if (field.type === 'ul') return <ul class={field.class}>{field.items.map(item => <li>{item}</li>)}</ul>;
            if (field.type === 'tags') return <div class={field.class}>{field.items.map(item => <Tag text={item} />)}</div>;
            if (field.type === 'h3') return <h3 class={field.class}>{field.value}</h3>;
            if (field.type === 'p') return <p class={field.class}>{field.value}</p>;
            if (field.type === 'a') return <a class={field.class} href={field.href}>{field.value}</a>;
            if (field.type === 'time') return <time class={field.class}>{field.value}</time>;
            if (field.type === 'span') return <span class={field.class}>{field.value}</span>;
            return <p class={field.class}>{field.value}</p>;
          })}
        </div>
      );
    }
    
    if (item.type === 'project') {
      return (
        <div class="project-item">
          <div class="project-header">
            {item.header.map((field) => {
              if (field.type === 'ul') return <ul class={field.class}>{field.items.map(item => <li>{item}</li>)}</ul>;
              if (field.type === 'tags') return <div class={field.class}>{field.items.map(item => <Tag text={item} />)}</div>;
              if (field.type === 'h3') return <h3 class={field.class}>{field.value}</h3>;
              if (field.type === 'p') return <p class={field.class}>{field.value}</p>;
              if (field.type === 'a') return <a class={field.class} href={field.href}>{field.value}</a>;
              if (field.type === 'time') return <time class={field.class}>{field.value}</time>;
              if (field.type === 'span') return <span class={field.class}>{field.value}</span>;
              return <p class={field.class}>{field.value}</p>;
            })}
          </div>
          {item.dates && <div class="project-dates"><DateRange start={item.dates.startDate} end={item.dates.endDate} /></div>}
          {item.content.map((field) => {
            if (field.type === 'ul') return <ul class={field.class}>{field.items.map(item => <li>{item}</li>)}</ul>;
            if (field.type === 'tags') return <div class={field.class}>{field.items.map(item => <Tag text={item} />)}</div>;
            if (field.type === 'h3') return <h3 class={field.class}>{field.value}</h3>;
            if (field.type === 'p') return <p class={field.class}>{field.value}</p>;
            if (field.type === 'a') return <a class={field.class} href={field.href}>{field.value}</a>;
            if (field.type === 'time') return <time class={field.class}>{field.value}</time>;
            if (field.type === 'span') return <span class={field.class}>{field.value}</span>;
            return <p class={field.class}>{field.value}</p>;
          })}
        </div>
      );
    }
    
    if (item.type === 'skill') {
      return (
        <div class="skill-item">
          {item.fields.map((field) => {
            if (field.type === 'ul') return <ul class={field.class}>{field.items.map(item => <li>{item}</li>)}</ul>;
            if (field.type === 'tags') return <div class={field.class}>{field.items.map(item => <Tag text={item} />)}</div>;
            if (field.type === 'h3') return <h3 class={field.class}>{field.value}</h3>;
            if (field.type === 'p') return <p class={field.class}>{field.value}</p>;
            if (field.type === 'a') return <a class={field.class} href={field.href}>{field.value}</a>;
            if (field.type === 'time') return <time class={field.class}>{field.value}</time>;
            if (field.type === 'span') return <span class={field.class}>{field.value}</span>;
            return <p class={field.class}>{field.value}</p>;
          })}
        </div>
      );
    }
    
    return (
      <div class="item">
        {item.fields.map((field) => {
          if (field.type === 'ul') return <ul class={field.class}>{field.items.map(item => <li>{item}</li>)}</ul>;
          if (field.type === 'tags') return <div class={field.class}>{field.items.map(item => <Tag text={item} />)}</div>;
          if (field.type === 'h3') return <h3 class={field.class}>{field.value}</h3>;
          if (field.type === 'p') return <p class={field.class}>{field.value}</p>;
          if (field.type === 'a') return <a class={field.class} href={field.href}>{field.value}</a>;
          if (field.type === 'time') return <time class={field.class}>{field.value}</time>;
          if (field.type === 'span') return <span class={field.class}>{field.value}</span>;
          return <p class={field.class}>{field.value}</p>;
        })}
      </div>
    );
  })}
</div> 