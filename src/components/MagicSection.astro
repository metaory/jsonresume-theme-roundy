---
import { renderData, getLayouts } from '../lib/render.js';
import Tag from './shared/Tag.astro';
import DateRange from './shared/DateRange.astro';

const { items, meta, sectionName } = Astro.props;

// Single-pass processing with layout
const layouts = getLayouts();
const processedItems = renderData(items, layouts[sectionName] || layouts.work);
---

<div class={`${sectionName}-section`}>
  {processedItems.map((item) => (
    <div class={layouts[sectionName]?.container || 'item'}>
      {item.map(section => (
        <div class={section.class}>
          {section.fields.map(field => {
            // Dynamic rendering based on field type
            if (field.isList) {
              return <ul class={field.class || ''}>{field.value.map(item => <li>{item}</li>)}</ul>;
            }
            
            if (field.isTags) {
              return <div class={field.class || ''}>{field.value.map(item => <Tag text={item} />)}</div>;
            }
            
            if (field.href) {
              const href = field.href === true ? field.value : field.href + field.value;
              return <a class={field.class || ''} href={href}>{field.value}</a>;
            }
            
            // Dynamic tag rendering
            const TagName = field.tag;
            return <TagName class={field.class || ''}>{field.value}</TagName>;
          })}
          {section.dateRange && <DateRange start={section.dateRange.start} end={section.dateRange.end} />}
        </div>
      ))}
    </div>
  ))}
</div> 