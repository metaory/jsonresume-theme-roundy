<button class="theme-toggle" aria-label="Toggle theme">
  <iconify-icon
    width="48"
    height="48"
    icon="line-md:sunny-filled-loop-to-moon-filled-alt-loop-transition"
  ></iconify-icon>
</button>

<script>
  import { toggleThemeMode } from "@lib/theme.js";

  const icons = {
    light: "line-md:sunny-filled-loop-to-moon-filled-alt-loop-transition",
    dark: "line-md:moon-filled-alt-to-sunny-filled-loop-transition",
  };

  const icon = document.querySelector(".theme-toggle iconify-icon");

  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    icon.setAttribute("icon", icons[toggleThemeMode()]);
  });
</script>

<style>
  .theme-toggle {
    position: fixed;
    top: 2em;
    right: 2em;
    /* top: var(--space-lg); */
    /* right: var(--space-lg); */
    z-index: 1000;
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: none;
    backdrop-filter: blur(4px);
    width: 48px;
    height: 48px;
    cursor: pointer;
    box-shadow: var(--shadow);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;

    iconify-icon {
      width: 48px;
      height: 48px;
      color: var(--primary);
    }

    @media print {
      display: none !important;
    }
  }
</style>
