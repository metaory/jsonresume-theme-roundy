---
import { renderField, renderConditional, renderAutoField, processContactItems } from '../lib/render.js';
import Icon from './shared/Icon.astro';

export interface Props {
  basics: any;
  meta: any;
}

const { basics, meta } = Astro.props;
const contactItems = processContactItems(basics, meta);
---

<div class="basics">
  <header class="header">
    {basics.image && <img src={basics.image} alt={basics.name} class="avatar" />}
    <div class="header-content">
      {basics.name && <h1 class="name">{basics.name}</h1>}
      {basics.label && <p class="label">{basics.label}</p>}
    </div>
  </header>

  <div class="contact">
    {contactItems.map(item => (
      <div class="contact-item">
        <Icon name="ph:envelope" size="1em" class="contact-icon" />
        <span class="contact-label">{item.label}:</span>
        {item.href ? <a href={item.href}>{item.value}</a> : <span>{item.value}</span>}
      </div>
    ))}
  </div>

  {renderConditional(basics.profiles, (
    <div class="profiles">
      <h3>Profiles</h3>
      <div class="profile-links">
        {basics.profiles.map(profile => (
          <a href={profile.url} target="_blank" rel="noopener" class="profile-link">
            {profile.network}: {profile.username}
          </a>
        ))}
      </div>
    </div>
  ))}

  {renderConditional(basics.summary, (
    <div class="summary">
      <h3>Summary</h3>
      {basics.summary.includes('<') ? 
        <div class="summary-content" set:html={basics.summary} /> :
        <p class="summary-content">{basics.summary}</p>
      }
    </div>
  ))}
</div>

<style>
  .basics {
    margin-bottom: var(--theme-spacing-2xl);
  }
  
  .header {
    display: flex;
    align-items: center;
    gap: var(--theme-spacing-lg);
    margin-bottom: var(--theme-spacing-xl);
  }
  
  .avatar {
    width: var(--theme-spacing-3xl);
    height: var(--theme-spacing-3xl);
    border-radius: var(--theme-border-radius-full);
    object-fit: cover;
  }
  
  .header-content h1 {
    margin: 0;
    color: var(--theme-color-primary);
  }
  
  .label {
    margin: var(--theme-spacing-xs) 0 0 0;
    font-size: var(--theme-font-size-lg);
    color: var(--theme-text-secondary);
  }
  
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--theme-spacing-md);
    margin-bottom: var(--theme-spacing-lg);
    background: var(--theme-surface-secondary);
    padding: var(--theme-spacing-lg);
    border-radius: var(--theme-border-radius-lg);
    border: var(--theme-border-width-thin) solid var(--theme-border-color);
  }
  
  .contact-item {
    display: flex;
    align-items: center;
    gap: var(--theme-spacing-xs);
  }
  
  .contact-icon {
    color: var(--theme-text-secondary);
  }
  
  .contact-label {
    font-weight: var(--theme-font-weight-semibold);
    color: var(--theme-text-secondary);
  }
  
  .profiles {
    margin-bottom: var(--theme-spacing-lg);
  }
  
  .profiles h3 {
    margin-bottom: var(--theme-spacing-md);
    color: var(--theme-color-primary);
  }
  
  .profile-link {
    display: inline-block;
    padding: var(--theme-spacing-sm) var(--theme-spacing-md);
    background: var(--theme-surface-secondary);
    border-radius: var(--theme-border-radius-md);
    font-size: var(--theme-font-size-sm);
    text-decoration: none;
    color: var(--theme-text-primary);
    border: var(--theme-border-width-thin) solid var(--theme-border-color);
    transition: all var(--theme-transition-normal) var(--theme-easing);
    margin-right: var(--theme-spacing-sm);
    margin-bottom: var(--theme-spacing-sm);
  }
  
  .profile-link:hover {
    background: var(--theme-color-primary);
    color: white;
    transform: translateY(-1px);
  }
  
  .summary {
    margin-bottom: var(--theme-spacing-lg);
  }
  
  .summary h3 {
    margin-bottom: var(--theme-spacing-md);
    color: var(--theme-color-primary);
  }
  
  .summary ul {
    margin: 0;
    padding-left: var(--theme-spacing-lg);
  }
  
  .summary li {
    margin-bottom: var(--theme-spacing-xs);
    line-height: 1.6;
  }
  
  @media (max-width: var(--theme-breakpoint-md)) {
    .header {
      flex-direction: column;
      text-align: center;
    }
    
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style> 