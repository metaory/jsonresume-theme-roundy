---
import { renderData, processContactItems } from '../lib/render.js';
import Tag from './shared/Tag.astro';

export interface Props {
  basics: any;
  meta: any;
}

const { basics, meta } = Astro.props;

// Single-pass processing
const headerFields = renderData({ name: basics.name, label: basics.label });
const contactItems = processContactItems(basics);
const profileFields = basics.profiles ? renderData({ profiles: basics.profiles }) : null;
const summaryFields = basics.summary ? renderData({ summary: basics.summary }) : null;
---

<div class="basics">
  <header class="header">
    {basics.image && <img src={basics.image} alt={basics.name} class="avatar" />}
    <div class="header-content">
      {headerFields.map((field) => {
        const TagName = field.tag;
        return <TagName class={field.class || ''}>{field.value}</TagName>;
      })}
    </div>
  </header>

  <div class="contact">
    {contactItems.map(item => (
      <div class="contact-item">
        <span class="contact-label">{item.label}:</span>
        {item.href ? <a href={item.href}>{item.value}</a> : <span>{item.value}</span>}
      </div>
    ))}
  </div>

  {profileFields && (
    <div class="profiles">
      <h3>Profiles</h3>
      {profileFields.map((field) => {
        if (field.isProfiles) {
          return (
            <div class={field.class || ''}>
              {field.value.map(profile => (
                <a href={profile.url} target="_blank" rel="noopener" class="profile-link">
                  {profile.network}: {profile.username}
                </a>
              ))}
            </div>
          );
        }
        return null;
      })}
    </div>
  )}

  {summaryFields && (
    <div class="summary">
      <h3>Summary</h3>
      {summaryFields.map((field) => {
        if (field.setHtml) return <div class={field.class || ''} set:html={field.value} />;
        const TagName = field.tag;
        return <TagName class={field.class || ''}>{field.value}</TagName>;
      })}
    </div>
  )}
</div>

<style>
  .basics {
    margin-bottom: var(--theme-spacing-2xl);
  }
  
  .header {
    display: flex;
    align-items: center;
    gap: var(--theme-spacing-lg);
    margin-bottom: var(--theme-spacing-xl);
  }
  
  .avatar {
    width: var(--theme-spacing-3xl);
    height: var(--theme-spacing-3xl);
    border-radius: var(--theme-border-radius-full);
    object-fit: cover;
  }
  
  .header-content h1 {
    margin: 0;
    color: var(--theme-color-primary);
  }
  
  .label {
    margin: var(--theme-spacing-xs) 0 0 0;
    font-size: var(--theme-font-size-lg);
    color: var(--theme-text-secondary);
  }
  
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--theme-container-max-width), 1fr));
    gap: var(--theme-spacing-sm);
    margin-bottom: var(--theme-spacing-lg);
  }
  
  .contact-item {
    display: flex;
    gap: var(--theme-spacing-xs);
  }
  
  .contact-label {
    font-weight: var(--theme-font-weight-semibold);
    color: var(--theme-text-secondary);
  }
  
  .profiles {
    margin-bottom: var(--theme-spacing-lg);
  }
  
  .profile-link {
    padding: var(--theme-spacing-xs) var(--theme-spacing-sm);
    background: var(--theme-surface-secondary);
    border-radius: var(--theme-border-radius-md);
    font-size: var(--theme-font-size-sm);
  }
  
  .summary {
    margin-bottom: var(--theme-spacing-lg);
  }
  
  @media (max-width: var(--theme-breakpoint-md)) {
    .header {
      flex-direction: column;
      text-align: center;
    }
    
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style> 