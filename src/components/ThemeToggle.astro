---
// Theme toggle component
import toggleClientUrl from './toggle.client.js?url'
---

<button class="theme-toggle" aria-label="Toggle theme">
    <iconify-icon width="48" height="48" class="light-icon" icon="line-md:sunny-filled-loop-to-moon-filled-alt-loop-transition"></iconify-icon>
    <iconify-icon width="48" height="48" class="dark-icon" icon="line-md:moon-filled-alt-to-sunny-filled-loop-transition"></iconify-icon>
</button>

<script type="module" src={toggleClientUrl}></script>

<style>
  .theme-toggle {
    position: fixed;
    top: var(--space-lg);
    right: var(--space-lg);
    z-index: 1000;
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: none;
    backdrop-filter: blur(4px);
    width: 48px;
    height: 48px;
    cursor: pointer;
    transition: all var(--transition);
    box-shadow: var(--shadow);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .theme-toggle:hover { box-shadow: var(--shadow-lg); }

  .theme-toggle iconify-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
    transition: opacity var(--transition);
  }

  .light-icon { color: var(--accent); }
  .dark-icon { color: var(--primary); }
  .light-icon { opacity: 1; }
  .dark-icon { opacity: 0; }
  [data-theme="dark"] .light-icon { opacity: 0; }
  [data-theme="dark"] .dark-icon { opacity: 1; }

  @media print { .theme-toggle { display: none !important; } }
</style>
