---
// Theme toggle component
---

<button class="theme-toggle" aria-label="Toggle theme">
    <iconify-icon width="48" height="48" class="light-icon" icon="line-md:sunny-filled-loop-to-moon-filled-alt-loop-transition"></iconify-icon>
    <iconify-icon width="48" height="48" class="dark-icon" icon="line-md:moon-filled-alt-to-sunny-filled-loop-transition"></iconify-icon>
</button>

<style>
  .theme-toggle {
    position: fixed;
    top: var(--space-lg);
    right: var(--space-lg);
    z-index: 1000;
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: none;
    backdrop-filter: blur(4px);
    width: 48px;
    height: 48px;
    cursor: pointer;
    transition: all var(--transition);
    box-shadow: var(--shadow);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* keep hover minimal for dev only */
  .theme-toggle:hover { box-shadow: var(--shadow-lg); }

  .theme-toggle iconify-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
    transition: opacity var(--transition);
  }

  .light-icon {
    color: var(--accent);
  }

  .dark-icon {
    color: var(--primary);
  }

  @media print {
    .theme-toggle {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.theme-toggle');
  const lightIcon = document.querySelector('.light-icon');
  const darkIcon = document.querySelector('.dark-icon');

  const showIcon = (isDark) => {
    if (lightIcon instanceof HTMLElement && darkIcon instanceof HTMLElement) {
      lightIcon.style.opacity = isDark ? '0' : '1';
      darkIcon.style.opacity = isDark ? '1' : '0';
    }
  };

  import { toggleThemeMode, reapplyForCurrentMode } from "@lib/theme.js";

  const toggleTheme = () => {
    const newMode = toggleThemeMode();
    document.documentElement.setAttribute('data-theme-manual', 'true');
    showIcon(newMode === 'dark');
    return newMode;
  };

  const updateIcon = () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    showIcon(isDark);
  };

  toggle?.addEventListener('click', toggleTheme);

  // Respect pre-set theme (from config or query) and then init icon
  const preset = document.documentElement.getAttribute('data-theme');
  if (!preset) {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
  }
  updateIcon();

  // Listen for system theme changes
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!document.documentElement.hasAttribute('data-theme-manual')) {
      document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
      updateIcon();
      reapplyForCurrentMode();
    }
  });

  // Mark as manual when user clicks toggle
  toggle?.addEventListener('click', () => {
    document.documentElement.setAttribute('data-theme-manual', 'true');
  });
</script>
