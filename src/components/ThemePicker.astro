---
import { OPEN_PROPS_COLORS } from "../lib/theme.js";
---

<div class="theme-picker">
  <button class="picker-tab" aria-label="Theme picker">
    <iconify-icon width="48" height="48" icon="solar:pallete-2-bold-duotone"></iconify-icon>
    <div class="logo-blob"></div>
  </button>
  {OPEN_PROPS_COLORS.map(color => (
    <button
      class="color-btn"
      data-color={color}
      style={`--color: var(--${color}-7)`}
      title={color}
    >
      <div class="color-circle"></div>
    </button>
  ))}
</div>

<style>
  .theme-picker {
    position: fixed;
    top: 50%;
    right: -200px;
    transform: translateY(-50%);
    z-index: var(--theme-z-modal);
    transition: right 0.4s ease-in-out;
    width: min-content;
    border-radius: 0;
    padding: 12px;
    display: grid;
    backdrop-filter: blur(4px);
    grid-template-columns: 1fr repeat(4,1fr);
    gap: 10px;
    justify-items: center;
  }

  .theme-picker::before {
    content: '';
    filter: blur(3em);
    z-index: -2;
    background: radial-gradient(
      circle at center,
      var(--theme-color-primary) 10%,
      var(--theme-color-secondary) 50%,
      transparent 70%
    );
    width: 300px;
    height: 300px;
    position: absolute;
    top: 0; left: 0;
  }

  .theme-picker:hover {
    right: -4px;
  }

  .picker-tab {
    grid-row: span 5;
    grid-column: 1;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--theme-color-primary);
    padding: 10px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    transition: all 2s ease;
  }

  iconify-icon {
    height: 48px;
    width: 48px;
    color: var(--theme-color-primary);
    animation: pulse 2s ease-in-out infinite;
    z-index:1;
    mix-blend-mode: plus-lighter;
  }

  .logo-blob {
    position: absolute;
    width: clamp(35px, 10vw, 50px);
    height: clamp(35px, 10vw, 50px);
    background: conic-gradient(from 0deg, #009494, #b1323b, #ba482e, #69314b, #0135a8, #009494);
    border-radius: 50%;
    opacity: 0.8;
    animation: pulse 1s linear infinite, blobRotate 3s linear infinite;
    filter: blur(8px);
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }


  @keyframes blobRotate {
    to { transform: rotate(360deg); }
  }


  .color-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    transition: all 0.2s ease;
  }

  .color-btn:hover {
    background: var(--theme-surface-tertiary);
    transform: scale(1.2);
    box-shadow: inset 0 0 12px var(--color), 0 0 14px var(--color);
  }

  .color-btn.active {
    background: var(--theme-color-primary);
    box-shadow: 0 0 14px var(--color);
  }

  .color-btn:nth-last-child(3) {
    grid-column: span 2;
    justify-self: center;
  }

  .color-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color);
  }

  @media print {
    .theme-picker {
      display: none !important;
    }
  }
</style>

<script>
  import { applyColorTheme, applyDarkModeTheme } from '../lib/theme.js';

  const applyTheme = (color) => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const themeVars = isDark ? applyDarkModeTheme(color) : applyColorTheme(color);

    Object.entries(themeVars).forEach(([key, value]) => {
      document.documentElement.style.setProperty(key, value);
    });

    document.documentElement.style.backgroundColor = isDark ? 'black' : 'white';
    localStorage.setItem('selectedThemeColor', color);

    document.querySelectorAll('.color-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelector(`[data-color="${color}"]`)?.classList.add('active');
  };

  const currentColor = localStorage.getItem('selectedThemeColor') || 'indigo';
  document.querySelector(`[data-color="${currentColor}"]`)?.classList.add('active');

  document.querySelectorAll('.color-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const color = btn.getAttribute('data-color');
      if (color) applyTheme(color);
    });
  });
</script>
