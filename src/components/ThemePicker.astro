---
import { OPEN_PROPS_COLORS } from '../lib/theme.js'
---

<div class="theme-picker">
  <button class="picker-tab" aria-label="Theme picker">
    <iconify-icon icon="solar:pallete-2-bold-duotone"></iconify-icon>
  </button>
  <div class="picker-panel">
    {OPEN_PROPS_COLORS.map(color => (
      <button
        class="color-btn"
        data-color={color}
        style={`--color: var(--${color}-7)`}
        title={color}
      >
        <div class="color-circle"></div>
      </button>
    ))}
  </div>
</div>

<style>
  .theme-picker {
    position: fixed;
    top: 50%;
    right: -200px;
    transform: translateY(-50%);
    z-index: var(--theme-z-modal);
    transition: right 0.2s ease;
  }

  .theme-picker:hover {
    right: 0;
  }

  .picker-tab {
    position: absolute;
    left: -40px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background: var(--theme-surface-primary);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .picker-tab iconify-icon {
    width: 20px;
    height: 20px;
    color: var(--theme-text-secondary);
  }

  .picker-panel {
    width: 200px;
    background: var(--theme-surface-primary);
    border-radius: 12px 0 0 12px;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
    padding: 12px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .color-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    transition: all 0.2s ease;
  }

  .color-btn:hover {
    background: var(--theme-surface-secondary);
    transform: scale(1.1);
  }

  .color-btn.active {
    background: var(--theme-color-primary);
  }

  .color-circle {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color);
    border: 2px solid var(--theme-surface-border);
  }

  [data-theme="dark"] .picker-tab,
  [data-theme="dark"] .picker-panel {
    background: var(--theme-surface-secondary);
  }

  @media print {
    .theme-picker {
      display: none !important;
    }
  }
</style>

<script>
  import { applyColorTheme, applyDarkModeTheme } from '../lib/theme.js';

  const applyTheme = (color) => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const themeVars = isDark ? applyDarkModeTheme(color) : applyColorTheme(color);

    Object.entries(themeVars).forEach(([key, value]) => {
      document.documentElement.style.setProperty(key, value);
    });

    document.documentElement.style.backgroundColor = isDark ? 'black' : 'white';
    localStorage.setItem('selectedThemeColor', color);

    document.querySelectorAll('.color-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelector(`[data-color="${color}"]`)?.classList.add('active');
  };

  // Initialize when DOM is ready
  const init = () => {
    const currentColor = localStorage.getItem('selectedThemeColor') || 'indigo';
    document.querySelector(`[data-color="${currentColor}"]`)?.classList.add('active');

    document.querySelectorAll('.color-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const color = btn.getAttribute('data-color');
        if (color) applyTheme(color);
      });
    });
  };

  // Run immediately if DOM is ready, otherwise wait
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
