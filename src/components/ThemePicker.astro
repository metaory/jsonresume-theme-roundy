---
// Theme picker with hue and saturation sliders
---

<div class="theme-picker">
  <button class="picker-tab" aria-label="Theme picker">
    <iconify-icon width="48" height="48" icon="solar:pallete-2-bold-duotone"></iconify-icon>
    <div class="logo-blob"></div>
  </button>
  
  <div class="controls">
    <div class="control-group">
      <label for="hue" class="control-label">hue</label>
      <span id="hue-value" class="control-value">240°</span>
      <input id="hue" class="hue-slider" type="range" min="0" max="360" step="1" />
    </div>
    
    <div class="control-group">
      <label for="sat" class="control-label">saturation</label>
      <span id="sat-value" class="control-value">60%</span>
      <input id="sat" class="sat-slider" type="range" min="0" max="100" step="1" />
    </div>
  </div>
</div>

<style>
  .theme-picker {
    position: fixed;
    top: 50%;
    right: -200px;
    transform: translateY(-50%);
    z-index: 1000;
    transition: right 0.5s cubic-bezier(0.3, 1.5, 0.6, 1);
    width: 280px;
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    backdrop-filter: blur(4px);
    background: var(--surface);
    border: none;
    box-shadow: var(--shadow-lg);
  }

  .theme-picker:hover {
    right: -4px;
  }

  .picker-tab {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--primary);
    padding: var(--space-md);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition);
    position: relative;
  }

  iconify-icon {
    height: 48px;
    width: 48px;
    color: white;
    animation: pulse 2s ease-in-out infinite;
    z-index: 1;
    mix-blend-mode: overlay;
  }

  .logo-blob {
    position: absolute;
    width: 48px;
    height: 48px;
    background: conic-gradient(from 0deg, #009494, #b1323b, #ba482e, #69314b, #0135a8, #009494);
    border-radius: 50%;
    opacity: 0.8;
    animation: blobRotate 4s linear infinite;
    filter: blur(8px);
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  @keyframes blobRotate {
    to { transform: rotate(360deg); }
  }

  .controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .control-label {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-transform: lowercase;
    font-weight: 500;
  }

  .control-value {
    font-size: var(--text-sm);
    color: var(--text);
    font-weight: 600;
    text-align: right;
  }


  .hue-slider, .sat-slider {
    appearance: none;
    width: 100%;
    height: 8px;
    border-radius: var(--radius);
    outline: none;
    cursor: pointer;
    transition: all var(--transition);
  }

  .hue-slider {
    background: linear-gradient(to right, 
      hsl(0, 100%, 50%), 
      hsl(60, 100%, 50%), 
      hsl(120, 100%, 50%), 
      hsl(180, 100%, 50%), 
      hsl(240, 100%, 50%), 
      hsl(300, 100%, 50%), 
      hsl(360, 100%, 50%)
    );
  }

  .sat-slider {
    background: linear-gradient(to right, 
      hsl(var(--hue), 0%, 50%), 
      hsl(var(--hue), 100%, 50%)
    );
  }

  .hue-slider::-webkit-slider-thumb,
  .sat-slider::-webkit-slider-thumb {
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: white;
    border: 3px solid var(--primary);
    cursor: pointer;
    transition: all var(--transition);
    box-shadow: var(--shadow);
  }

  .hue-slider::-webkit-slider-thumb:hover,
  .sat-slider::-webkit-slider-thumb:hover {
    transform: scale(1.1);
    box-shadow: var(--shadow-lg);
  }

  .hue-slider::-moz-range-thumb,
  .sat-slider::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: white;
    border: 3px solid var(--primary);
    cursor: pointer;
    transition: all var(--transition);
    box-shadow: var(--shadow);
  }

  .hue-slider::-moz-range-track,
  .sat-slider::-moz-range-track {
    height: 8px;
    border-radius: var(--radius);
    border: none;
  }


  @media (max-width: 768px) {
    .theme-picker {
      right: -200px;
      transform: translateY(-50%) scale(0.9);
      width: 240px;
      padding: var(--space-md);
    }
    
    .theme-picker:hover {
      right: -4px;
      transform: translateY(-50%) scale(1);
    }
  }

  @media (max-width: 480px) {
    .theme-picker {
      right: -180px;
      transform: translateY(-50%) scale(0.8);
      width: 200px;
    }
    
    .theme-picker:hover {
      right: -4px;
      transform: translateY(-50%) scale(0.9);
    }
  }

  @media print {
    .theme-picker {
      display: none !important;
    }
  }
</style>

<script>
  import { applyThemeAuto, updateSatGradient, readHue, readSat } from "@lib/theme.js";

  const initSliders = () => {
    const hueEl = document.getElementById('hue');
    const satEl = document.getElementById('sat');
    const hueVal = document.getElementById('hue-value');
    const satVal = document.getElementById('sat-value');

    if (hueEl instanceof HTMLInputElement && satEl instanceof HTMLInputElement && hueVal && satVal) {
      let raf = 0;

      const onChange = () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          document.documentElement.setAttribute('data-theme-manual', 'true');
          const h = Number(hueEl.value);
          const s = Number(satEl.value);
          hueVal.textContent = `${h}°`;
          satVal.textContent = `${s}%`;
          applyThemeAuto(h, s);
          updateSatGradient(satEl, h);
        });
      };

      hueEl.addEventListener('input', onChange);
      satEl.addEventListener('input', onChange);

      // Sync initial from CSS in case values were set via config
      const initHue = readHue();
      const initSat = readSat();
      hueEl.value = String(initHue);
      satEl.value = String(initSat);
      hueVal.textContent = `${initHue}°`;
      satVal.textContent = `${initSat}%`;
      updateSatGradient(satEl, initHue);
    }
  };

  initSliders();
</script>
