---
import pkg from '@pkg'

const githubUrl = pkg.homepage || pkg.repository
---

<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="github-link" aria-label="View on GitHub">
  <iconify-icon icon="tabler:brand-github-filled" width="24" height="24"></iconify-icon>
</a>

<style>
  .github-link {
    position: fixed;
    bottom: var(--space-lg);
    left: var(--space-lg);
    z-index: 100;
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--space-sm);
    box-shadow: var(--shadow);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    text-decoration: none;
    transition: transform 0.2s ease;

    iconify-icon {
      color: var(--text-muted);
      transition: color 0.2s ease;
    }

    &:hover {
      transform: scale(1.1);

      iconify-icon {
        color: var(--primary);
      }
    }

    @media print {
      display: none !important;
    }
  }
</style>
