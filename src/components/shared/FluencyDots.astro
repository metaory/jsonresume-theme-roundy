---
import { getLevelMapping } from '@lib/levels.js'

const { fluency, class: className = '' } = Astro.props

const config = getLevelMapping(fluency)
const dots = config.dots
const levelClass = config.class.replace('level-', '')
---

<div class={`fluency-dots ${levelClass} ${className}`}>
  {Array.from({ length: 5 }, (_, i) => (
    <div class={`dot ${i < dots ? 'filled' : 'empty'}`}></div>
  ))}
  <span class="fluency-label">{fluency}</span>
</div>

<style>
  .fluency-dots {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .card-compact .fluency-dots {
    margin-top: 0;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transition: all var(--transition);
    position: relative;
  }

  .dot.filled {
    background: var(--level-color);
    box-shadow: 0 0 8px hsl(from var(--level-color) h s l / 0.4), inset 0 1px 2px rgba(255, 255, 255, 0.3);
    transform: scale(1);
  }

  .dot.empty {
    background: var(--surface);
    border: 1px solid hsl(from var(--level-color) h s l / 0.6);
    transform: scale(0.8);
  }

  .fluency-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--level-color);
    margin-left: var(--space-sm);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  /* Level-specific colors */
  .beginner { --level-color: var(--primary); }
  .intermediate { --level-color: var(--secondary); }
  .advanced { --level-color: var(--accent); }
  .master { --level-color: var(--primary); }
  .expert { --level-color: var(--accent); }

  /* Hover effects */
  .fluency-dots:hover .dot.filled {
    transform: scale(1.1);
    box-shadow: 0 0 12px hsl(from var(--level-color) h s l / 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.4);
  }

  .fluency-dots:hover .dot.empty {
    border-color: hsl(from var(--level-color) h s l / 0.8);
    transform: scale(0.9);
  }

  .fluency-dots:hover .fluency-label {
    color: var(--level-color);
    font-weight: 600;
  }
</style>
