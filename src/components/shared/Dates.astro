---
const { class: className = '' } = Astro.props
---

<p class={`dates ${className}`}>
  <slot />
</p>

<style>
  .dates {
    font-family: var(--font-dates);
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: var(--space-sm) 0;
  }

  /* Compact dates for grid items */
  .projects-grid .dates {
    margin: var(--space-xs) 0;
    font-size: var(--text-xs);
  }
</style> 