---
import Tag from '@shared/Tag.astro'
import { getIconForKeyword } from '@lib/icons.js'

const { 
  keywords = [], 
  variant = 'default',
  size = 'sm',
  class: className = '',
  meta
} = Astro.props
---

<div class={`keywords ${className}`}>
  {keywords.map((keyword: string) => (
    <Tag 
      text={keyword} 
      icon={getIconForKeyword(keyword, meta)}
      variant={variant}
      size={size}
    />
  ))}
</div>

<style>
  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
  }

  /* Compact keywords for grid items */
  .skills-grid .keywords,
  .interests-grid .keywords,
  .projects-grid .keywords {
    margin-top: var(--space-xs);
  }

  /* Remove default margins from tags in keywords containers */
  .keywords .tag {
    margin: 0;
  }

  /* Compact tags for grid items */
  .skills-grid .keywords .tag,
  .interests-grid .keywords .tag,
  .projects-grid .keywords .tag {
    font-size: var(--text-xs);
  }
</style> 