---
const { class: className = '', variant = 'default' } = Astro.props

const variants = {
  default: 'divider-default',
  subtle: 'divider-subtle',
  accent: 'divider-accent',
  gradient: 'divider-gradient'
}
---

<div class={`divider ${variants[variant]} ${className}`}></div>

<style>
  .divider {
    height: 16px;
    display: block;
    position: relative;
    margin: var(--space-2xl) 0;
    width: 100%;
    background-image: url('/src/assets/line.svg');
    background-size: 30px 26px;
    background-repeat: space;
    opacity: 0.6;
  }

  /* Variants */
  .divider-default {
    filter: hue-rotate(0deg) brightness(1);
  }

  .divider-subtle {
    opacity: 0.2;
    filter: grayscale(0.5);
  }

  .divider-accent {
    filter: hue-rotate(180deg) saturate(1.5);
  }

  .divider-gradient {
    background: linear-gradient(90deg, transparent, var(--primary), transparent);
    height: 2px;
    border-radius: var(--radius-full);
    margin: var(--space-xl) 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .divider {
      margin: var(--space-xl) 0;
      height: 20px;
      background-size: 40px 30px;
    }
  }

  /* Print styles */
  @media print {
    .divider {
      opacity: 0.4;
    }

    .divider:hover {
      opacity: 0.4;
    }
  }
</style> 