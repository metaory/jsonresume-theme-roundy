---
interface Props {
  name: string;
  size?: string | number;
  color?: string;
  class?: string;
  style?: string;
}

const { name, size = "1em", color, class: className, style } = Astro.props;
---

<iconify-icon 
  icon={name}
  style={`font-size: ${size}; ${color ? `color: ${color};` : ''} ${style || ''}`}
  class={className}
></iconify-icon> 