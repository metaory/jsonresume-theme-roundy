---
import Divider from '@shared/Divider.astro'
import { getIconForSection } from '@lib/icons.js'

const { title, showDivider = true, dividerVariant = 'subtle', meta } = Astro.props;
const sectionIcon = getIconForSection(title, meta)
---

<section class="section">
  <h2 class="section-title">
    <iconify-icon icon={sectionIcon} class="section-icon"></iconify-icon>
    {title}
  </h2>
  <slot />
  {showDivider && <Divider variant={dividerVariant} />}
</section>

<style>
  .section {
    margin-bottom: var(--space-2xl);
    padding: var(--space-xl);
    position: relative;
    background: var(--surface);
    color: var(--contrast-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    backdrop-filter: blur(6px);
    display: grid;
    gap: var(--space-lg);

    &:last-child {
      border-bottom: none;
      margin-bottom: 0;

      .divider {
        display: none;
      }
    }

    @media (max-width: 768px) {
      padding: var(--space-lg);
      margin-bottom: var(--space-2xl);
    }
  }

  .section-title {
    font-family: var(--font);
    color: var(--primary);
    font-size: var(--text-xl);
    font-weight: 600;
    position: relative;
    padding-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;

    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 60px;
      height: 3px;
      background: var(--primary);
      border-radius: 4px;
    }
  }

  .section-icon {
    font-size: 1.2em;
    color: var(--accent);
  }
</style>
