---
import Divider from '@shared/Divider.astro'
import { getIconForSection } from '@lib/icons.js'

const { title, class: className = '', showDivider = true, dividerVariant = 'subtle', meta } = Astro.props;
const sectionIcon = getIconForSection(title, meta)
---

<section class={`section ${className}`}>
  <h2 class="section-title">
    <iconify-icon icon={sectionIcon} class="section-icon"></iconify-icon>
    {title}
  </h2>
  <slot />
  {showDivider && <Divider variant={dividerVariant} />}
</section>

<style>
  .section {
    margin-bottom: var(--space-2xl);
    padding: var(--space-xl);
    position: relative;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    backdrop-filter: blur(6px);
    display: grid;
    gap: var(--space-lg);
  }

  .section:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }

  .section:last-child .divider {
    display: none;
  }

  .section-title {
    font-family: var(--font);
    color: var(--primary);
    font-size: var(--text-xl);
    font-weight: 600;
    position: relative;
    padding-bottom: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
  }

  .section-icon {
    font-size: 1.2em;
    color: var(--accent);
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: var(--primary);
    border-radius: var(--radius-full);
  }

  /* Grid handles spacing automatically */

  @media (max-width: 768px) {
    .section {
      padding: var(--space-lg);
      margin-bottom: var(--space-2xl);
    }
  }
</style> 