---
const { class: className = '' } = Astro.props
---

<p class={`subtitle ${className}`}>
  <slot />
</p>

<style>
  .subtitle {
    font-family: var(--font-sub-header);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    margin: 0 0 var(--space-sm) 0;
  }
</style> 