---
import Tag from './Tag.astro';
import DateRange from './DateRange.astro';

export interface Props {
  items: any[];
  meta: any;
}

const { items, meta } = Astro.props;
---

<div class="projects-grid">
  {items.map((project: any) => (
    <div class="project-item">
      <div class="project-header">
        <h3>{project.name}</h3>
        {project.url && (
          <a href={project.url} target="_blank" rel="noopener" class="project-url">
            View Project
          </a>
        )}
      </div>
      
      {project.startDate && (
        <div class="project-dates">
          <DateRange start={project.startDate} end={project.endDate} />
        </div>
      )}
      
      {project.description && <p class="project-description">{project.description}</p>}
      
      {project.highlights?.length && (
        <ul class="project-highlights">
          {project.highlights.map((highlight: string) => <li>{highlight}</li>)}
        </ul>
      )}
      
      {project.keywords?.length && (
        <div class="project-keywords">
          {project.keywords.map((keyword: string) => <Tag text={keyword} />)}
        </div>
      )}
      
      {project.roles?.length && (
        <div class="project-roles">
          <strong>Roles:</strong> {project.roles.join(', ')}
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-lg);
  }
  
  .project-item {
    padding: var(--spacing-lg);
    background: var(--background-2);
    border-radius: var(--border-radius-lg);
  }
  
  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-sm);
  }
  
  .project-header h3 {
    margin: 0;
    color: var(--primary-1);
  }
  
  .project-url {
    font-size: var(--font-size-sm);
    white-space: nowrap;
    color: var(--link-1);
    text-decoration: none;
  }
  
  .project-url:hover {
    text-decoration: underline;
  }
  
  .project-dates {
    font-size: var(--font-size-sm);
    color: var(--secondary-1);
    margin-bottom: var(--spacing-sm);
  }
  
  .project-description {
    margin-bottom: var(--spacing-sm);
    line-height: 1.6;
  }
  
  .project-highlights {
    margin: var(--spacing-sm) 0;
    padding-left: var(--spacing-lg);
  }
  
  .project-highlights li {
    margin-bottom: var(--spacing-xs);
  }
  
  .project-keywords {
    margin-top: var(--spacing-sm);
  }
  
  .project-roles {
    margin-top: var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--secondary-1);
  }
</style> 