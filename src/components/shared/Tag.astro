---
const {
  text,
  icon,
  href,
  variant = 'default',
  size = 'md',
  class: className = ''
} = Astro.props;

const variants = ['default', 'primary', 'secondary', 'outline', 'ghost', 'link', 'subtle']
const sizes = ['sm', 'md', 'lg']

const getVariantClass = (variant) => `tag-${variant}`
const getSizeClass = (size) => `tag-${size}`

const TagElement = href ? 'a' : 'span';
const tagProps = href ? { href, target: '_blank', rel: 'noopener' } : {};
---

<TagElement
  class={`tag ${getVariantClass(variant)} ${getSizeClass(size)} ${className}`}
  {...tagProps}
>
  {icon && <iconify-icon icon={icon} class="tag-icon" />}
  <span class="tag-text">{text}</span>
</TagElement>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    border-radius: var(--radius);
    font-family: var(--font);
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition);
    cursor: pointer;
    width: fit-content;
    justify-self: start;
  }

  .tag-icon {
    font-size: 0.9em;
    color: var(--accent);
  }

  .tag-text {
    line-height: 1;
  }

  /* Tag Variants */
  .tag-default { --tag-bg: var(--surface); --tag-color: var(--text-muted); }
  .tag-primary { --tag-bg: var(--primary); --tag-color: white; }
  .tag-secondary { --tag-bg: var(--secondary); --tag-color: white; }
  .tag-outline { --tag-bg: transparent; --tag-color: var(--text); }
  .tag-ghost { --tag-bg: transparent; --tag-color: var(--text-muted); }
  .tag-link { --tag-bg: transparent; --tag-color: var(--link); text-decoration: underline; }
  .tag-subtle { 
    --tag-bg: var(--surface); 
    --tag-color: var(--text-muted); 
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .tag {
    background: var(--tag-bg);
    color: var(--tag-color);
  }

  /* Tag Sizes */
  .tag-sm { padding: var(--space-xs); font-size: var(--text-xs); }
  .tag-md { padding: var(--space-xs) var(--space-sm); font-size: var(--text-sm); }
  .tag-lg {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-base);
    border-radius: var(--radius-lg);
  }

  /* Tag Hover States */
  /* minimal hover for dev; PDF-first */
</style>
