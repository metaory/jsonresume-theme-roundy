---
const {
  text,
  icon,
  href,
  variant = 'default',
  size = 'md',
  class: className = ''
} = Astro.props;

const variants = {
  default: 'tag-default',
  primary: 'tag-primary',
  secondary: 'tag-secondary',
  outline: 'tag-outline',
  ghost: 'tag-ghost',
  link: 'tag-link'
};

const sizes = {
  sm: 'tag-sm',
  md: 'tag-md',
  lg: 'tag-lg'
};

const TagElement = href ? 'a' : 'span';
const tagProps = href ? { href, target: '_blank', rel: 'noopener' } : {};
---

<TagElement
  class={`tag ${variants[variant]} ${sizes[size]} ${className}`}
  {...tagProps}
>
  {icon && <iconify-icon icon={icon} class="tag-icon" />}
  <span class="tag-text">{text}</span>
</TagElement>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    border-radius: var(--radius);
    font-family: var(--font-links);
    font-weight: 500;
    text-decoration: none;
    transition: all var(--transition) var(--transition);
    cursor: pointer;
    width: fit-content;
    justify-self: start;
  }

  .tag-icon {
    font-size: 0.9em;
    color: var(--accent);
  }

  .tag-text {
    line-height: 1;
  }

  /* Tag Variants */
  .tag-default {
    background: var(--surface);
    color: var(--text-muted);
  }

  .tag-primary {
    background: var(--primary);
    color: white;
  }

  .tag-secondary {
    background: var(--secondary);
    color: white;
  }

  .tag-outline {
    background: transparent;
    color: var(--text);
  }

  .tag-ghost {
    background: transparent;
    color: var(--text-muted);
  }

  .tag-link {
    background: transparent;
    color: var(--link);
    text-decoration: underline;
  }

  /* Tag Sizes */
  .tag-sm {
    padding: var(--space-xs);
    font-size: var(--text-xs);
    border-radius: var(--radius);
  }

  .tag-md {
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-sm);
    border-radius: var(--radius);
  }

  .tag-lg {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-base);
    border-radius: var(--radius-lg);
  }

  /* Tag Hover States */
  /* minimal hover for dev; PDF-first */
</style>
