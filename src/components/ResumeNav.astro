---
/** @type {{ currentResume?: string, availableResumes?: string[] }} */
const p = Astro.props
const currentResume = p.currentResume ?? 'resume'
const resumes = /** @type {string[]} */ (p.availableResumes ?? [])
/** @type {{ name: string }[]} */
const resumeFiles = []
for (const name of resumes) {
	const s = String(name)
	resumeFiles.push({ name: s.charAt(0).toUpperCase() + s.slice(1) })
}
---

<nav class="resume-nav">
  {resumeFiles.map((file) => (
    <a
      href={`/${file.name.toLowerCase()}`}
      class={`nav-link ${currentResume === file.name.toLowerCase() ? 'active' : ''}`}
    >
      {file.name}
    </a>
  ))}
</nav>

<style>
  .resume-nav {
    position: fixed;
    top: var(--space-lg);
    left: var(--space-lg);
    z-index: 100;
    display: flex;
    gap: var(--space-sm);
    background: var(--surface);
    padding: var(--space-sm);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 20px var(--surface);
    backdrop-filter: blur(8px);
  }

  .nav-link {
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: all var(--transition);
    box-shadow: 0 0 0 1px transparent;
  }

  .nav-link:hover { color: var(--text); background: var(--text-muted); box-shadow: 0 4px 20px var(--text-muted); }
  .nav-link.active { color: var(--primary); background: var(--text-muted); box-shadow: 0 4px 20px var(--text-muted); }

  @media print { .resume-nav { display: none !important; } }
</style>
