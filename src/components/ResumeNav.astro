---
const { currentResume = 'resume.json', availableResumes = [] } = Astro.props

// Generate resume files array from available resumes
const resumeFiles = availableResumes.map(name => ({
	name: name.charAt(0).toUpperCase() + name.slice(1), // Capitalize first letter
	file: `${name}.json`,
}))
---

<nav class="resume-nav">
  {resumeFiles.map(({ name, file }) => (
    <a
      href={`/${name.toLowerCase()}`}
      class={`nav-link ${currentResume === name.toLowerCase() ? 'active' : ''}`}
    >
      {name}
    </a>
  ))}
</nav>

<style>
  .resume-nav {
    position: fixed;
    top: var(--theme-spacing-lg);
    left: var(--theme-spacing-lg);
    z-index: 100;
    display: flex;
    gap: var(--theme-spacing-sm);
    background: var(--theme-surface-secondary);
    padding: var(--theme-spacing-sm);
    border-radius: var(--theme-border-radius-lg);
    box-shadow: 0 0 20px var(--theme-surface-secondary);
    backdrop-filter: blur(8px);
  }

  .nav-link {
    padding: var(--theme-spacing-xs) var(--theme-spacing-sm);
    border-radius: var(--theme-border-radius-md);
    text-decoration: none;
    color: var(--theme-color-muted);
    font-size: var(--theme-font-size-sm);
    font-weight: 500;
    transition: all var(--theme-transition-fast) var(--theme-easing);
    box-shadow: 0 0 0 1px transparent;
  }

  .nav-link:hover {
    color: var(--theme-text-primary);
    background: var(--theme-color-muted);
    box-shadow: 0 4px 20px var(--theme-color-muted);
  }

  .nav-link.active {
    color: var(--theme-color-primary);
    background: var(--theme-color-muted);
    box-shadow: 0 4px 20px var(--theme-color-muted);
  }

  @media (max-width: 768px) {
    .resume-nav {
      top: var(--theme-spacing-md);
      left: var(--theme-spacing-md);
      padding: var(--theme-spacing-xs);
    }
  }

  @media print {
    .resume-nav {
      display: none;
    }
  }
</style>
