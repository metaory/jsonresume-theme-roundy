---
import { getResumeInfo } from "@lib/resume.js";

/** @type {{ currentResume?: string, availableResumes?: string[] }} */
const p = Astro.props;
const currentResume = p.currentResume ?? "resume";
const resumes = /** @type {string[]} */ (p.availableResumes ?? []);
const resumeFiles = resumes.map((name) => getResumeInfo(name));
---

<nav class="resume-nav">
  {
    resumeFiles.map((file) => (
      <a
        href={`${import.meta.env.BASE_URL}${file.name}`}
        class={`nav-link ${currentResume === file.name ? "active" : ""}`}
      >
        {file.displayName}
      </a>
    ))
  }
</nav>

<style>
  .resume-nav {
    position: fixed;
    top: 2em;
    left: 2em;
    /* top: var(--space-lg); */
    /* left: var(--space-lg); */
    z-index: 100;
    display: flex;
    gap: var(--space-sm);
    background: var(--surface);
    padding: var(--space-sm);
    border-radius: var(--radius-lg);
    box-shadow: 0 0 20px var(--surface);
    backdrop-filter: blur(8px);

    @media print {
      display: none !important;
    }
  }

  .nav-link {
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius);
    border: 1px dashed transparent;
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: border-color 0.2s, color 0.2s;

    &:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    &.active {
      color: var(--primary);
      background: var(--surface);
    }
  }
</style>
