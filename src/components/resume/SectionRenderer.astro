---
import Section from "@ui/Section.astro";
import ListLayout from "./ListLayout.astro";
import CardLayout from "./CardLayout.astro";

const { sectionKey, data, meta } = Astro.props;

// Section configuration - single source of truth
const sections = {
  work: {
    title: "Work Experience",
    layout: "list",
    fields: [
      "name>title",
      "position>subtitle",
      "startDate,endDate>dates",
      "summary>description",
      "highlights>list",
      "keywords",
      "seniority>level",
      "url",
    ],
  },
  projects: {
    title: "Projects",
    layout: "list",
    fields: [
      "name>title",
      "description",
      "highlights>list",
      "keywords:secondary",
      "complexity>level",
      "url",
    ],
  },
  education: {
    title: "Education",
    layout: "list",
    fields: [
      "institution>title",
      "studyType,area>subtitle",
      "startDate,endDate>dates",
      "score",
      "courses>list",
      "url",
    ],
  },
  volunteer: {
    title: "Volunteer",
    layout: "list",
    fields: [
      "organization>title",
      "position>subtitle",
      "startDate,endDate>dates",
      "summary>description",
      "highlights>list",
      "url",
    ],
  },
  publications: {
    title: "Publications",
    layout: "list",
    fields: ["name>title", "publisher>subtitle", "releaseDate>dates", "url"],
  },
  references: {
    title: "References",
    layout: "list",
    fields: ["name>title", "reference>subtitle"],
  },
  awards: {
    title: "Awards",
    layout: "list",
    fields: [
      "title>title",
      "awarder>subtitle",
      "date>dates",
      "summary>description",
    ],
  },
  certificates: {
    title: "Certificates",
    layout: "list",
    fields: ["name>title", "issuer>subtitle", "date>dates", "url"],
  },
  skills: {
    title: "Skills",
    layout: "cards",
    fields: ["name>title", "keywords", "level"],
  },
  languages: {
    title: "Languages",
    layout: "cards",
    fields: ["language>title", "fluency"],
  },
  interests: {
    title: "Interests",
    layout: "cards",
    fields: ["name>title", "keywords", "level"],
  },
};

const config = sections[sectionKey] || {
  title: sectionKey,
  layout: "list",
  fields: [],
};
const title = meta?.themeOptions?.sectionTitles?.[sectionKey] || config.title;
const items = Array.isArray(data) ? data : [];

// Field processors with custom logic for specific cases
const processors = {
  "studyType,area": (item) =>
    `${item.studyType || ""} in ${item.area || ""}`.trim(),
  "startDate,endDate": (item) =>
    `${item.startDate || ""} - ${item.endDate || "Present"}`.replace(
      /^[\s-]+|[\s-]+$/g,
      "",
    ),
  subtitle: (item, fields) => processors[fields]?.(item) || item[fields],
  dates: (item, fields) => processors[fields]?.(item) || item[fields],
  description: (item, field) => item[field] || item.summary,
  default: (item, field) => item[field],
};

// Process field definitions into render data
const processItem = (item) => {
  const result = {};

  config.fields.forEach((fieldDef) => {
    const [sourceFields, targetType = sourceFields] = fieldDef.split(">");
    const [type, variant] = targetType.split(":");
    const processor = processors[type] || processors.default;

    const value = processor(item, sourceFields);
    if (!value || (Array.isArray(value) && !value.length)) return;

    result[type] = { value, variant };
  });

  return result;
};

const processedItems = items.map(processItem);
---

<Section title={title} meta={meta}>
  {config.layout === "cards" ? (
    <CardLayout processedItems={processedItems} meta={meta} />
  ) : (
    <ListLayout processedItems={processedItems} meta={meta} />
  )}
</Section>
