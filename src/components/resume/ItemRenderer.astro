---
import Card from "@ui/Card.astro";
import FieldRenderer from "./FieldRenderer.astro";

const { itemData, layout, meta } = Astro.props;
---

<Card layout={layout === "cards" ? "card" : "item"}>
  {Object.entries(itemData).map(([type, data]) => (
    data && 
    typeof data === "object" && 
    "value" in data && 
    "variant" in data && (
      <FieldRenderer 
        type={type} 
        value={data.value} 
        variant={data.variant} 
        meta={meta} 
      />
    )
  ))}
</Card>
