---
import Tag from "@ui/Tag.astro";

const { basics } = Astro.props;
const base = import.meta.env.BASE_URL ?? "/";
const resolveAsset = (path) =>
  !path
    ? ""
    : /^https?:\/\//i.test(path)
      ? path
      : `${base}${path.replace(/^\//, "")}`;
const logoUrl = resolveAsset(basics.logo);
const imageUrl = resolveAsset(basics.image);
---

<header class="basics">
  {
    logoUrl && (
      <div class="logo">
        <img src={logoUrl} alt="Logo" class="logo-img" />
      </div>
    )
  }

  <div class="name-section">
    <div class="name-title">
      {
        imageUrl && (
          <div class="profile-image">
            <img src={imageUrl} alt={basics.name} class="avatar" />
          </div>
        )
      }
      <div class="name-content">
        <h1 class="name">{basics.name}</h1>
        <p class="label" set:html={basics.label} />
      </div>
    </div>
  </div>

  <div class="contact-card surface-elevated">
    <div class="contact-info">
      <Tag
        text={basics.email}
        icon="mdi:email"
        href={`mailto:${basics.email}`}
        variant="subtle"
      />
      <Tag
        text={basics.phone}
        icon="mdi:phone"
        href={`tel:${basics.phone}`}
        variant="subtle"
      />
      <Tag text={basics.url} icon="mdi:web" href={basics.url} variant="subtle" />
    </div>
    <div class="location">
    <Tag
      text={[
        basics.location?.address,
        basics.location?.city,
        basics.location?.region,
        basics.location?.postalCode,
      ]
        .filter(Boolean)
        .join(", ")}
      icon="mdi:map-marker"
      variant="subtle"
    />
    </div>
    <div class="profiles">
      {
        (basics.profiles || []).map(
          (profile: { network?: string; username?: string; url?: string }) => (
            <Tag
              text={profile.username}
              icon={`mdi:${profile.network?.toLowerCase()}`}
              href={profile.url}
              variant="subtle"
              size="md"
            />
          ),
        )
      }
    </div>
  </div>

  <div class="summary-card surface-elevated">
    <div class="summary" set:html={basics.summary} />
  </div>
</header>

<style>
  .basics {
    position: relative;
    text-align: center;
    margin-bottom: var(--space-2xl);
    padding-top: var(--space-2xl);
  }

  .logo {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 10;
  }

  .logo-img {
    width: 68px;
    height: 68px;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.1));
  }

  .name-section {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid color-mix(in srgb, var(--text-muted) 22%, transparent);
  }

  .name-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .profile-image {
    flex-shrink: 0;
  }

  .avatar {
    width: 100px;
    height: 100px;
    border-radius: var(--radius-xl);
    object-fit: cover;
    border: 3px solid var(--primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .name-content {
    text-align: left;
  }

  .name {
    font-family: var(--font-marker);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 var(--space-sm) 0;
    text-shadow:
      2px 2px 0 var(--primary),
      4px 4px 0 var(--secondary),
      6px 6px 0 var(--accent),
      8px 8px 0 var(--primary),
      10px 10px 0 var(--secondary),
      12px 12px 16px rgba(0, 0, 0, 0.4),
      16px 16px 24px rgba(0, 0, 0, 0.2);
  }

  .label {
    font-family: var(--font-bungee);
    font-size: 1.125rem;
    color: var(--heading-sub-color);
    margin: 0;
    font-weight: 500;
    line-height: 1.5;
  }

  .contact-card {
    padding: var(--surface-elevated-padding);
    margin: var(--space-xl) auto 0;
    max-width: 700px;
    display: grid;
    gap: var(--space-lg);
  }

  .contact-info {
    display: grid;
    gap: var(--space-md);
    grid-auto-flow: column;
    max-width: 800px;
    margin: 0 auto;
  }

  .location {
    display: flex;
    justify-content: center;
    margin: 0;
  }

  .profiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    justify-content: center;
    gap: var(--space-md);
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .summary-card {
    padding: var(--surface-elevated-padding);
    margin: var(--space-xl) auto 0;
    max-width: 700px;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 768px) {
    .contact-card {
      padding: var(--surface-elevated-padding-sm);
      margin-top: var(--space-lg);
    }

    .summary-card {
      padding: var(--surface-elevated-padding-sm);
      margin-top: var(--space-lg);
    }
  }

  .summary {
    text-align: left;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;

    ul {
      margin: 0;
      padding-left: var(--space-lg);
    }

    li {
      margin-bottom: var(--space-xs);
    }
  }

  @media (max-width: 768px) {
    .name {
      font-size: 2rem;
    }

    .avatar {
      width: 80px;
      height: 80px;
    }
  }

  @media (max-width: 480px) {
    .profiles {
      grid-template-columns: 1fr;
    }
  }
</style>
