---
import Title from "@ui/Title.astro";
import Subtitle from "@ui/Subtitle.astro";
import Dates from "@ui/Dates.astro";
import Description from "@ui/Description.astro";
import LevelField from "@resume/LevelField.astro";
import ListField from "@resume/ListField.astro";
import KeywordsField from "@resume/KeywordsField.astro";
import UrlField from "@resume/UrlField.astro";
import ScoreField from "@resume/ScoreField.astro";

const { type, value, variant, meta } = Astro.props;

const componentMap = {
  title: Title,
  subtitle: Subtitle,
  dates: Dates,
  description: Description,
  level: LevelField,
  fluency: LevelField,
  list: ListField,
  keywords: KeywordsField,
  url: UrlField,
  score: ScoreField,
};

const Component = componentMap[type];
---

{Component && <Component value={value} variant={variant} meta={meta} />}
