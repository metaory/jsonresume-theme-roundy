---
import TitleField from "./fields/TitleField.astro";
import SubtitleField from "./fields/SubtitleField.astro";
import DatesField from "./fields/DatesField.astro";
import DescriptionField from "./fields/DescriptionField.astro";
import LevelField from "./fields/LevelField.astro";
import ListField from "./fields/ListField.astro";
import KeywordsField from "./fields/KeywordsField.astro";
import UrlField from "./fields/UrlField.astro";
import ScoreField from "./fields/ScoreField.astro";

const { type, value, variant, meta } = Astro.props;

const componentMap = {
  title: TitleField,
  subtitle: SubtitleField,
  dates: DatesField,
  description: DescriptionField,
  level: LevelField,
  fluency: LevelField,
  list: ListField,
  keywords: KeywordsField,
  url: UrlField,
  score: ScoreField,
};

const Component = componentMap[type];
---

{Component && <Component value={value} variant={variant} meta={meta} />}
