---
import Section from '@shared/Section.astro'
import Item from '@shared/Item.astro'
import Title from '@shared/Title.astro'
import Subtitle from '@shared/Subtitle.astro'
import Dates from '@shared/Dates.astro'
import Description from '@shared/Description.astro'
import List from '@shared/List.astro'
import Keywords from '@shared/Keywords.astro'
import LevelBar from '@shared/LevelBar.astro'

const { work, meta, resumeData } = Astro.props
---

<Section title={meta?.themeOptions?.sectionTitles?.work || "Work Experience"} meta={meta} resumeData={resumeData}>
  {work.map(job => (
    <Item class="work-item">
      <Title>{job.name}</Title>
      <Subtitle>{job.position}</Subtitle>
      {job.seniority && <LevelBar level={job.seniority} />}
      <a href={job.url} target="_blank" rel="noopener">{job.url}</a>
      <Dates>{job.startDate} - {job.endDate || 'Present'}</Dates>
      <Description>{job.summary}</Description>
      <List>
        {(job.highlights || []).map(highlight => <li>{highlight}</li>)}
      </List>
      <Keywords
        keywords={job.keywords || []}
        variant="primary"
        size="sm"
        meta={meta}
        resumeData={resumeData}
      />
    </Item>
  ))}
</Section>

<style>
  .work-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--theme-spacing-sm);
    align-items: start;
  }

  .work-item .title,
  .work-item .subtitle {
    margin: 0;
  }

  .work-item .level-bar {
    grid-column: 2;
    grid-row: 1 / 3;
    margin: 0;
    max-width: 200px;
    align-self: start;
  }

  .work-item a,
  .work-item .dates,
  .work-item .description,
  .work-item .list,
  .work-item .keywords {
    grid-column: 1;
  }
</style>
