---
import Tag from '@shared/Tag.astro'

const { basics } = Astro.props
---

<header class="basics">
  {basics.logo && (
    <div class="logo">
      <img src={basics.logo} alt="Logo" class="logo-img" />
    </div>
  )}

  <div class="name-section">
    <div class="name-title">
      {basics.image && (
        <div class="profile-image">
          <img src={basics.image} alt={basics.name} class="avatar" />
        </div>
      )}
      <div class="name-content">
        <h1 class="name">{basics.name}</h1>
        <p class="label">{basics.label}</p>
      </div>
    </div>
  </div>

  <div class="contact-info">
    <Tag
      text={basics.email}
      icon="mdi:email"
      href={`mailto:${basics.email}`}
      variant="subtle"
    />

    <Tag
      text={basics.phone}
      icon="mdi:phone"
      href={`tel:${basics.phone}`}
      variant="subtle"
    />

    <Tag
      text={basics.url}
      icon="mdi:web"
      href={basics.url}
      variant="subtle"
    />
  </div>

  <div class="location">
    <Tag
      text={[
        basics.location?.address,
        basics.location?.city,
        basics.location?.region,
        basics.location?.postalCode
      ].filter(Boolean).join(', ')}
      icon="mdi:map-marker"
      variant="subtle"
    />
  </div>

  <div class="profiles">
    {(basics.profiles || []).map((profile: { network?: string, username?: string, url?: string }) => (
      <Tag
        text={profile.username}
        icon={`mdi:${profile.network?.toLowerCase()}`}
        href={profile.url}
        variant="subtle"
        size="md"
      />
    ))}
  </div>

  <div class="summary-card">
    <div class="summary" set:html={basics.summary} />
  </div>
</header>

<style>
  .basics {
    position: relative;
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .logo {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 10;
  }

  .logo-img {
    width: 68px;
    height: 68px;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.1));
  }

  .name-section {
    margin-bottom: var(--space-lg);
  }

  .name-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .profile-image {
    flex-shrink: 0;
  }

  .avatar {
    width: 100px;
    height: 100px;
    border-radius: var(--radius-xl);
    object-fit: cover;
    border: 3px solid var(--primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .name-content {
    text-align: left;
  }

  .name {
    font-family: var(--font-marker);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 var(--space-sm) 0;
    text-shadow: 
      2px 2px 0 var(--primary),
      4px 4px 0 var(--secondary),
      6px 6px 0 var(--accent),
      8px 8px 0 var(--primary),
      10px 10px 0 var(--secondary),
      12px 12px 16px rgba(0, 0, 0, 0.4),
      16px 16px 24px rgba(0, 0, 0, 0.2);
  }

  .label {
    font-family: var(--font-links);
    font-size: 1.125rem;
    color: var(--text-muted);
    margin: 0;
    font-weight: 500;
    line-height: 1.4;
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .location {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-lg);
  }

  .profiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .summary-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    margin: var(--space-xl) auto 0;
    max-width: 700px;
    box-shadow: var(--shadow);
    backdrop-filter: blur(8px);
  }

  .summary {
    text-align: left;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .summary ul {
    margin: 0;
    padding-left: var(--space-lg);
  }

  .summary li {
    margin-bottom: var(--space-xs);
  }

  @media (max-width: 768px) {
    .name {
      font-size: 2rem;
    }

    .avatar {
      width: 80px;
      height: 80px;
    }

    .summary-card {
      padding: var(--space-lg);
      margin-top: var(--space-lg);
    }
  }

  @media (max-width: 480px) {
    .profiles {
      grid-template-columns: 1fr;
    }
  }
</style>
