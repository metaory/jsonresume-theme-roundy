---
import Section from '@shared/Section.astro'
import Item from '@shared/Item.astro'
import Title from '@shared/Title.astro'
import Subtitle from '@shared/Subtitle.astro'
import Dates from '@shared/Dates.astro'
import Description from '@shared/Description.astro'
import List from '@shared/List.astro'

const { volunteer, meta } = Astro.props
---

<Section title={meta?.themeOptions?.sectionTitles?.volunteer || "Volunteer"} meta={meta}>
  {volunteer.map(vol => (
    <Item>
      <Title>{vol.organization}</Title>
      <Subtitle>{vol.position}</Subtitle>
      <a href={vol.url} target="_blank" rel="noopener">{vol.url}</a>
      <Dates>{vol.startDate} - {vol.endDate || 'Present'}</Dates>
      <Description>{vol.summary}</Description>
      <List>
        {(vol.highlights || []).map(highlight => <li>{highlight}</li>)}
      </List>
    </Item>
  ))}
</Section> 
