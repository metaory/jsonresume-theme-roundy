---
import Section from '@shared/Section.astro'
import Item from '@shared/Item.astro'
import Title from '@shared/Title.astro'
import Dates from '@shared/Dates.astro'
import Description from '@shared/Description.astro'
import Keywords from '@shared/Keywords.astro'
import LevelBar from '@shared/LevelBar.astro'

const { projects, meta } = Astro.props
---

<Section title={meta?.themeOptions?.sectionTitles?.projects || "Projects"} meta={meta}>
  <div class="projects-grid">
    {projects.map(project => (
      <Item>
        <div class="project-header">
          <Title>{project.name}</Title>
          {project.complexity && <LevelBar level={project.complexity} />}
        </div>
        <a href={project.url} target="_blank" rel="noopener">{project.url}</a>
        <Description>{project.description}</Description>
        <Dates>{project.startDate} - {project.endDate || 'Present'}</Dates>
        <Keywords 
          keywords={project.keywords || []} 
          variant="secondary"
          size="sm"
        meta={meta}
        />
      </Item>
    ))}
  </div>
</Section>

<style>
  .projects-grid {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: 0;
    padding: var(--space-md) 0;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    align-items: start;
  }

  .project-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .project-title-section {
    /* No specific styling needed - grid handles layout */
  }

  .project-header .level-bar {
    margin: 0;
    max-width: 200px;
  }

  .projects-grid a {
    display: block;
    margin: var(--space-xs) 0;
    font-size: var(--text-xs);
    word-break: break-all;
  }

  .projects-grid .description {
    margin: var(--space-xs) 0;
    line-height: 1.5;
    font-size: var(--text-sm);
  }

  @media (max-width: var(1024px)) {
    .projects-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  @media (max-width: var(768px)) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style> 