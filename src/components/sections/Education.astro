---
import Section from '@shared/Section.astro'
import Item from '@shared/Item.astro'
import Title from '@shared/Title.astro'
import Subtitle from '@shared/Subtitle.astro'
import Dates from '@shared/Dates.astro'
import List from '@shared/List.astro'
import LevelBar from '@shared/LevelBar.astro'

const { education, meta } = Astro.props

function getGPALevel(score) {
  const gpa = parseFloat(score);
  if (gpa >= 3.8) return 'Master';
  if (gpa >= 3.5) return 'Advanced';
  if (gpa >= 3.0) return 'Intermediate';
  return 'Beginner';
}
---

<Section title={meta?.themeOptions?.sectionTitles?.education || "Education"} meta={meta}>
  {education.map(edu => (
    <Item class="education-item">
      <Title>{edu.institution}</Title>
      <Subtitle>{edu.studyType} in {edu.area}</Subtitle>
      {edu.score && (
        <>
          <span class="gpa-label">GPA</span>
          <LevelBar level={getGPALevel(edu.score)} />
        </>
      )}
      <a href={edu.url} target="_blank" rel="noopener">{edu.url}</a>
      <Dates>{edu.startDate} - {edu.endDate || 'Present'}</Dates>
      <h4 class="courses-title">Courses:</h4>
      <List class="courses-list">
        {(edu.courses || []).map(course => <li>{course}</li>)}
      </List>
    </Item>
  ))}
</Section>

<style>
  .education-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--theme-spacing-sm);
    align-items: start;
  }

  .education-item .title,
  .education-item .subtitle {
    margin: 0;
  }

  .education-item .gpa-label {
    grid-column: 2;
    grid-row: 1;
    font-size: var(--theme-font-size-sm);
    color: var(--theme-text-secondary);
    font-weight: var(--theme-font-weight-medium);
    min-width: 30px;
    justify-self: end;
  }

  .education-item .level-bar {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    max-width: 200px;
    align-self: start;
  }

  .education-item a,
  .education-item .dates,
  .education-item .courses-title,
  .education-item .courses-list {
    grid-column: 1;
  }

  .education-item .courses-title {
    color: var(--theme-text-primary);
    margin: var(--theme-spacing-sm) 0 var(--theme-spacing-xs) 0;
  }
</style> 