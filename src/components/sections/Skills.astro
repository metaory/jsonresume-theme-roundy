---
import Section from '@shared/Section.astro'
import Item from '@shared/Item.astro'
import Title from '@shared/Title.astro'
import Keywords from '@shared/Keywords.astro'
import LevelBar from '@shared/LevelBar.astro'

const { skills, meta } = Astro.props
---

<Section title={meta?.themeOptions?.sectionTitles?.skills || "Skills"} meta={meta}>
  <div class="skills-grid">
    {skills.map(skill => (
      <Item class="skill-item">
        <Title>{skill.name}</Title>
        <LevelBar level={skill.level} />
        <Keywords 
          keywords={skill.keywords || []} 
          variant="default"
          size="sm"
          meta={meta}
        />
      </Item>
    ))}
  </div>
</Section>

<style>
  .skills-grid {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: 0;
    padding: var(--space-md) 0;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: start;
  }

  .skill-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-sm);
    align-items: start;
  }

  .skill-item .title {
    margin: 0;
    font-size: 1.1rem;
  }

  .skill-item .level-bar {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    max-width: 200px;
  }

  .skill-item .keywords {
    grid-column: 1;
  }

  .skills-grid .keywords {
    margin-top: var(--space-xs);
  }

  .skills-grid .keywords .tag {
    font-size: var(--text-xs);
    margin: 0;
  }

  @media (max-width: var(1024px)) {
    .skills-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
  }

  @media (max-width: var(768px)) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style> 