---
import Section from '@shared/Section.astro'
import Item from '@shared/Item.astro'
import Title from '@shared/Title.astro'
import Keywords from '@shared/Keywords.astro'
import LevelBar from '@shared/LevelBar.astro'
import { getIconForKeyword } from '@lib/icons.js'

const { interests, meta } = Astro.props
---

<Section title={meta?.themeOptions?.sectionTitles?.interests || "Interests"} meta={meta}>
  <div class="interests-grid">
    {interests.map(interest => {
      const interestIcon = getIconForKeyword(interest.name, meta)
      return (
        <Item>
          <div class="interest-header">
            <div class="interest-title">
              <iconify-icon icon={interestIcon} class="interest-icon"></iconify-icon>
              <Title>{interest.name}</Title>
            </div>
            {interest.level && <LevelBar level={interest.level} />}
          </div>
          <Keywords 
            keywords={interest.keywords || []} 
            variant="outline"
            size="sm"
            meta={meta}
          />
        </Item>
      )
    })}
  </div>
</Section>

<style>
  .interests-grid {
    display: grid;
    gap: var(--space-lg);
    margin-bottom: 0;
    padding: var(--space-md) 0;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    align-items: start;
  }

  .interest-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .interest-title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .interest-icon {
    font-size: 1.2rem;
  }

  .interest-header .title {
    margin: 0;
    font-size: 1.1rem;
  }

  .interest-header .level-bar {
    margin: 0;
    max-width: 200px;
  }

  .interests-grid .keywords {
    margin-top: var(--space-xs);
  }

  .interests-grid .keywords .tag {
    font-size: var(--text-xs);
    margin: 0;
  }

  @media (max-width: var(1024px)) {
    .interests-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  @media (max-width: var(768px)) {
    .interests-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style> 