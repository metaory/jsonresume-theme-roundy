---
const { layout = "card", ...props } = Astro.props;
const Element = layout === "card" ? "article" : "div";
---

<Element class={`container container-${layout}`} {...props}>
  <slot />
</Element>

<style>
  .container {
    background: var(--surface);
    color: var(--contrast-white);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow);
    display: grid;
    gap: var(--space-xs);
    height: fit-content;
  }
  
  .container-card {
    backdrop-filter: blur(4px);
  }
  
  .container-item {
    backdrop-filter: blur(4px);
  }
</style>
