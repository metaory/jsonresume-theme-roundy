---
const { layout = "card", ...props } = Astro.props;
const Element = layout === "card" ? "article" : "div";
---

<Element class={`container container-${layout} surface-elevated-inset`} {...props}>
  <slot />
</Element>

<style>
  .container {
    padding: var(--surface-elevated-padding-sm);
    display: grid;
    gap: var(--space-xs);
    height: fit-content;
  }

  .container-card {
    backdrop-filter: blur(4px);
  }

  .container-item {
    backdrop-filter: blur(4px);
  }
</style>
