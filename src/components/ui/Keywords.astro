---
import Tag from "@ui/Tag.astro";
import { getIconForKeyword } from "@lib/icons.js";

const { keywords = [], variant = "default", size = "sm", meta } = Astro.props;
---

<div class="keywords">
  {
    keywords.map((keyword: string) => (
      <Tag
        text={keyword}
        icon={getIconForKeyword(keyword, meta)}
        variant={variant}
        size={size}
      />
    ))
  }
</div>

<style>
  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;

    .tag {
      margin: 0;
      font-size: var(--text-xs);
    }
  }
</style>
