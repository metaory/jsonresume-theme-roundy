---
import { getLevelConfig } from "@lib/levels.js";

const { level } = Astro.props;
const { dots, color } = getLevelConfig(level);
---

<div class="level-dots" style={`--level-color: ${color}`}>
  {Array.from({ length: dots }, () => <div class="dot" />)}
</div>

<style>
  .level-dots {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--level-color);
    box-shadow: 0 0 6px hsl(from var(--level-color) h s l / 0.4);
  }
</style>
