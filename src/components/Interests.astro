---
import Icon from './shared/Icon.astro';

const { items, meta } = Astro.props;

// Get interest categories from meta config or use defaults
const interestConfig = meta?.themeOptions?.componentConfig?.interests?.categories || {
  'Terminals': { icon: 'ph:terminal', color: '#10b981' },
  'Window Managers': { icon: 'ph:monitor', color: '#3b82f6' },
  'Text Editors': { icon: 'ph:file-text', color: '#f59e0b' },
  'default': { icon: 'ph:heart', color: '#ef4444' }
};
---

<div class="interests">
  <div class="interests-flow">
    {items.map(interest => {
      const config = interestConfig[interest.name] || interestConfig.default;
      return (
        <div class="interest-category">
          <div class="category-header">
            <Icon 
              name={config.icon} 
              size="1.2em" 
              style={`color: ${config.color};`}
            />
            <h4 class="category-name">{interest.name}</h4>
          </div>
          
          {interest.keywords && (
            <div class="category-items">
              {interest.keywords.map(keyword => (
                <div class="interest-item">
                  <Icon name="ph:dot" size="0.8em" style={`color: ${config.color};`} />
                  <span class="item-name">{keyword}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      );
    })}
  </div>
</div>

<style>
  .interests {
    display: flex;
    flex-direction: column;
    gap: var(--theme-spacing-lg);
  }
  
  .interests-flow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--theme-spacing-xl);
  }
  
  .interest-category {
    flex: 1;
    min-width: 250px;
    background: var(--theme-surface-secondary);
    border-radius: var(--theme-border-radius-lg);
    padding: var(--theme-spacing-lg);
    border: var(--theme-border-width-thin) solid var(--theme-border-color);
    transition: transform var(--theme-transition-normal) var(--theme-easing);
  }
  
  .interest-category:hover {
    transform: translateY(-2px);
  }
  
  .category-header {
    display: flex;
    align-items: center;
    gap: var(--theme-spacing-sm);
    margin-bottom: var(--theme-spacing-md);
    padding-bottom: var(--theme-spacing-sm);
    border-bottom: var(--theme-border-width-thin) solid var(--theme-border-color);
  }
  
  .category-name {
    margin: 0;
    font-size: var(--theme-font-size-lg);
    font-weight: var(--theme-font-weight-semibold);
    color: var(--theme-text-primary);
  }
  
  .category-items {
    display: flex;
    flex-direction: column;
    gap: var(--theme-spacing-xs);
  }
  
  .interest-item {
    display: flex;
    align-items: center;
    gap: var(--theme-spacing-xs);
    padding: var(--theme-spacing-xs) 0;
  }
  
  .item-name {
    font-size: var(--theme-font-size-sm);
    color: var(--theme-text-secondary);
  }
  
  @media (max-width: 768px) {
    .interests-flow {
      flex-direction: column;
    }
    
    .interest-category {
      min-width: auto;
    }
  }
</style> 