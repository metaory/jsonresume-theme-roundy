---
import ThemeToggle from '@components/ThemeToggle.astro';
import ThemePicker from '@components/ThemePicker.astro';
import ResumeNav from '@components/ResumeNav.astro';
import iconifyUrl from 'iconify-icon?url';
import initThemeUrl from '@lib/init-theme.js?url';

export interface Props {
  title?: string;
  description?: string;
  initialHue?: number;
  initialSat?: number;
  initialDark?: boolean;
  currentResume?: string;
  availableResumes?: string[];
}

const { 
  title = 'Resume',
  description = 'Professional Resume',
  initialHue = 240,
  initialSat = 60,
  initialDark,
  currentResume,
  availableResumes = []
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme={initialDark ? 'dark' : 'light'} style={`--hue: ${initialHue}; --sat: ${initialSat};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="module" src={iconifyUrl}></script>

    <style is:global>
      @import '../styles/global.css';
      @import '../styles/fonts.css';
    </style>

    <style>.resume{max-width:800px;margin:0 auto;padding:var(--space-xl);overflow-x:hidden}@media (max-width:768px){.resume{padding:var(--space-lg)}}</style>

    <script type="module" src={initThemeUrl}></script>
  </head>

  <body>
    <ThemeToggle />
    {import.meta.env.DEV && <ThemePicker />}
    {availableResumes.length > 0 && <ResumeNav currentResume={currentResume} availableResumes={availableResumes} />}

    <main class="resume">
      <slot />
    </main>
  </body>
</html>