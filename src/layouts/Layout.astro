---
import "@fontsource/bungee-shade";
import "@fontsource/bungee";
import "@fontsource/baloo-2";
import "@fontsource/rubik";
import "@fontsource/fredoka";
import "@fontsource/permanent-marker";
import "@fontsource/blackout-midnight";

import ThemeToggle from "@components/ThemeToggle.astro";
import ThemePicker from "@components/ThemePicker.astro";
import ResumeNav from "@components/ResumeNav.astro";
import VersionInfo from "@shared/VersionInfo.astro";
import GitHubLink from "@shared/GitHubLink.astro";
import { THEME_DEFAULTS } from "@lib/theme.js";
import pkg from "@pkg";

const {
  title = pkg.name,
  description = pkg.description,
  themeOptions = {},
  currentResume,
  availableResumes = [],
  resumeData,
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  style={`--hue: ${themeOptions.hue || THEME_DEFAULTS.hue}; --sat: ${themeOptions.sat || THEME_DEFAULTS.sat};`}
  data-theme={themeOptions.dark ? "dark" : "light"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#3b82f6" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo.png" />
    <meta property="og:url" content={pkg.homepage || Astro.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/logo.png" />

    <style is:global>
      @import "@styles/global.css";
      @import "@styles/fonts.css";
    </style>

    <script>
      import "iconify-icon";
    </script>
  </head>

  <body>
    <ThemeToggle />
    {import.meta.env.DEV && <ThemePicker />}
    {
      availableResumes.length > 0 && (
        <ResumeNav
          currentResume={currentResume}
          availableResumes={availableResumes}
        />
      )
    }
    <VersionInfo resumeData={resumeData} />
    <GitHubLink />
    <main class="resume">
      <slot />
    </main>
  </body>
</html>
