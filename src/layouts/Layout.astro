---
import ThemeToggle from '@components/ThemeToggle.astro';
import ThemePicker from '@components/ThemePicker.astro';
import ResumeNav from '@components/ResumeNav.astro';

const {
  title = 'Resume',
  description = 'Professional Resume',
  initialHue = 240,
  initialSat = 60,
  initialDark,
  currentResume,
  availableResumes = []
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme={initialDark ? 'dark' : 'light'} style={`--hue: ${initialHue}; --sat: ${initialSat};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:global>
      @import '@styles/global.css';
      @import '@styles/fonts.css';
    </style>

    <script>
      import { initTheme } from '@lib/theme.js'
      import 'iconify-icon';
      initTheme()
    </script>
  </head>

  <body>
    <ThemeToggle />
    {import.meta.env.DEV && <ThemePicker />}
    {availableResumes.length > 0 && <ResumeNav currentResume={currentResume} availableResumes={availableResumes} />}

    <main class="resume">
      <slot />
    </main>
  </body>
</html>
