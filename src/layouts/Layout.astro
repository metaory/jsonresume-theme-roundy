---
import '@fontsource/bungee-shade'
import '@fontsource/bungee'
import '@fontsource/baloo-2'
import '@fontsource/rubik'
import '@fontsource/fredoka'
import '@fontsource/permanent-marker'
import '@fontsource/blackout-midnight'

import ThemeToggle from '@components/ThemeToggle.astro';
import ThemePicker from '@components/ThemePicker.astro';
import ResumeNav from '@components/ResumeNav.astro';

const {
  title = 'Resume',
  description = 'Professional Resume',
  themeOptions = {},
  currentResume,
  availableResumes = []
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" style={`--hue: ${themeOptions.hue || 240}; --sat: ${themeOptions.sat || 60};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:global>
      @import '@styles/global.css';
      @import '@styles/fonts.css';
    </style>

    <script>
      import 'iconify-icon';
    </script>
    
  </head>

  <body>
    <ThemeToggle />
    {import.meta.env.DEV && <ThemePicker />}
    {availableResumes.length > 0 && 
      <ResumeNav currentResume={currentResume} availableResumes={availableResumes} />
    }
    <main class="resume">
      <slot />
    </main>
  </body>
</html>
