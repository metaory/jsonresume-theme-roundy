{
  "name": "jsonresume-theme-roundy",
  "type": "module",
  "version": "0.5.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pdf:resume": "chromium --headless --disable-gpu --no-sandbox --disable-dev-shm-usage --no-pdf-header-footer --print-to-pdf=resume.pdf http://localhost:4321/resume",
    "pdf:private": "chromium --headless --disable-gpu --no-sandbox --disable-dev-shm-usage --no-pdf-header-footer --print-to-pdf=private.pdf http://localhost:4321/private",
    "pdf:resume-light": "chromium --headless --disable-gpu --no-sandbox --disable-dev-shm-usage --no-pdf-header-footer --print-to-pdf=resume-light.pdf http://localhost:4321/resume?theme=light",
    "pdf:resume-dark": "chromium --headless --disable-gpu --no-sandbox --disable-dev-shm-usage --no-pdf-header-footer --print-to-pdf=resume-dark.pdf http://localhost:4321/resume?theme=dark",
    "pdf:private-light": "chromium --headless --disable-gpu --no-sandbox --disable-dev-shm-usage --no-pdf-header-footer --print-to-pdf=private-light.pdf http://localhost:4321/private?theme=light",
    "pdf:private-dark": "chromium --headless --disable-gpu --no-sandbox --disable-dev-shm-usage --no-pdf-header-footer --print-to-pdf=private-dark.pdf http://localhost:4321/private?theme=dark",
    "pdf:all": "npm run pdf:resume-light && npm run pdf:resume-dark && npm run pdf:private-light && npm run pdf:private-dark",
    "pdf:resume-all": "npm run pdf:resume-light && npm run pdf:resume-dark",
    "pdf:private-all": "npm run pdf:private-light && npm run pdf:private-dark"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.2.6",
    "@fontsource/bungee": "^5.2.6",
    "@fontsource/bungee-shade": "^5.2.6",
    "@fontsource/fredoka": "^5.2.8",
    "@fontsource/rubik": "^5.2.6",
    "astro": "^5.13.1",
    "iconify-icon": "^3.0.0",
    "open-props": "^1.7.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3"
  }
}
