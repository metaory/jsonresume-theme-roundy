{
  "name": "jsonresume-theme-roundy",
  "description": "Modern, customizable JSON Resume theme with round design elements",
  "version": "0.7.0",
  "author": "metaory <metaory@gmail.com>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/metaory/jsonresume-theme-roundy",
  "repository": "https://github.com/metaory/jsonresume-theme-roundy.git",
  "bugs": "https://github.com/metaory/jsonresume-theme-roundy/issues",
  "keywords": [
    "jsonresume",
    "resume",
    "theme",
    "cv",
    "portfolio"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "pdf:sample": "chromium --headless --disable-gpu --no-sandbox --disable-dev-shm-usage --no-pdf-header-footer --print-to-pdf=out/sample-basic.pdf http://localhost:4321/basic",
    "pdf:private": "chromium --headless --disable-gpu --no-sandbox --disable-dev-shm-usage --no-pdf-header-footer --print-to-pdf=out/private.pdf http://localhost:4321/private",
    "build:screenshot": "chromium --headless --disable-gpu --virtual-time-budget=2000 --screenshot=out/screenshot.png --clip=0,0,780,790 http://localhost:4321/basic"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.2.6",
    "@fontsource/blackout-midnight": "^5.2.5",
    "@fontsource/bungee": "^5.2.6",
    "@fontsource/bungee-shade": "^5.2.6",
    "@fontsource/fredoka": "^5.2.8",
    "@fontsource/permanent-marker": "^5.2.6",
    "@fontsource/rubik": "^5.2.6",
    "astro": "^5.13.6",
    "iconify-icon": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.2.3",
    "typescript": "^5.9.2"
  }
}
